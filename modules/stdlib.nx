fn cat(path) {
  fd = open(path 0)
  if fd < 0 {
    out "[cat] cannot open: " + path
    ret ""
  }
  data = read(fd 4096)
  close(fd)
  ret data
}

fn ls(path) {
  items = keys(path)
  n = len(items)
  i = 0
  loop {
    if i >= n { break }
    out "  " + str(items[i])
    i = i + 1
  }
}

fn cp(src dst) {
  data = cat(src)
  fd = open(dst 1)
  if fd < 0 {
    out "[cp] cannot open dst: " + dst
    ret -1
  }
  write(fd data)
  close(fd)
  ret 0
}

fn mv(src dst) {
  cp(src dst)
  rm(src)
}

fn rm(path) {
  reg_del(path)
}

fn echo(s) {
  out s
}

fn exists(path) {
  fd = open(path 0)
  if fd < 0 {
    ret 0
  }
  close(fd)
  ret 1
}

fn pwd() {
  ret reg /proc/1/cwd
}

fn sleep_ms(ms) {
  sleep(ms)
}
