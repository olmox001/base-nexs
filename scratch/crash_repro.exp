#!/usr/bin/expect -f
set timeout 30
spawn ./nexs example/minios/boot.nx
expect "nexs-os:/"
sleep 1
# Test 1: 3-word garbage (the original crash)
send "cdacd dcac da\r"
expect {
    "nexs-os:/" {
        puts "\n=== TEST 1 SURVIVED ==="
    }
    eof { puts "\n=== CRASHED TEST 1 ==="; exit 1 }
    timeout { puts "\n=== TIMEOUT ==="; exit 1 }
}
sleep 0.5
# Test 2: another multi-word garbage
send "foo bar baz qux\r"
expect {
    "nexs-os:/" {
        puts "\n=== TEST 2 SURVIVED ==="
    }
    eof { puts "\n=== CRASHED TEST 2 ==="; exit 1 }
    timeout { puts "\n=== TIMEOUT ==="; exit 1 }
}
sleep 0.5
# Test 3: single word (was already working)
send "nonexistent\r"
expect {
    "nexs-os:/" {
        puts "\n=== TEST 3 SURVIVED ==="
    }
    eof { puts "\n=== CRASHED TEST 3 ==="; exit 1 }
    timeout { puts "\n=== TIMEOUT ==="; exit 1 }
}
sleep 0.5
# Test 4: ls (verify normal commands still work)
send "ls\r"
expect {
    "nexs-os:/" {
        puts "\n=== TEST 4 SURVIVED ==="
    }
    eof { puts "\n=== CRASHED TEST 4 ==="; exit 1 }
    timeout { puts "\n=== TIMEOUT ==="; exit 1 }
}
sleep 0.5
# Test 5: help
send "help\r"
expect {
    "nexs-os:/" {
        puts "\n=== TEST 5 SURVIVED ==="
    }
    eof { puts "\n=== CRASHED TEST 5 ==="; exit 1 }
    timeout { puts "\n=== TIMEOUT ==="; exit 1 }
}
sleep 0.5
# Exit cleanly
send "exit\r"
expect eof
puts "\n=== ALL 5 TESTS PASSED ==="
