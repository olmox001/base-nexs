# services/auth/init.nx — Auth service
library "auth"
# Handles user authentication and capabilities.
# Security rings: 0=machine/HW, 1=root/NEXS-admin, 2=user, 3=guest
# Capabilities stored at /sys/auth/caps/<name>/

reg /sys/auth/ring = 2

fn auth_set_ring(r) {
  if r < 0 { r = 0 }
  if r > 3 { r = 3 }
  reg /sys/auth/ring = r
  out "[auth] Ring set to " + str(r)
  ret 0
}

fn auth_get_ring() {
  ret reg /sys/auth/ring
}

fn auth_cap_grant(name cap) {
  reg_set("/sys/auth/caps/" + name + "/" + cap "1")
  out "[auth] Granted cap=" + cap + " to " + name
  ret 0
}

fn auth_cap_revoke(name cap) {
  reg_del("/sys/auth/caps/" + name + "/" + cap)
  out "[auth] Revoked cap=" + cap + " from " + name
  ret 0
}

fn auth_cap_check(name cap) {
  v = reg_get("/sys/auth/caps/" + name + "/" + cap)
  if v == "1" { ret 1 }
  ret 0
}

fn auth_require_ring(r) {
  cur = reg /sys/auth/ring
  if cur > r {
    out "[auth] EPERM: ring " + str(cur) + " cannot perform ring-" + str(r) + " operation"
    ret 0
  }
  ret 1
}

# Boot grants: ring 1 gets admin cap
auth_cap_grant("root" "admin")
auth_cap_grant("root" "mount")
auth_cap_grant("root" "exec")

reg /sys/auth/status = "ready"
out "[auth] Auth service initialised."
