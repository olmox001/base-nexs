reg /sys/init/status = "booting"
reg /sys/init/pid    = 1

exec("services/stdlib.nx")

out "[init] NEXS PID 1 starting..."

# Security first
exec("services/auth/init.nx")

# Mount namespaces
exec("services/fs/init.nx")

# Process manager
exec("services/pm/init.nx")

# TTY / console
exec("services/tty/init.nx")

# UI framebuffer
exec("services/ui/init.nx")

reg /sys/init/status = "running"
out "[init] All services running."

# Wait loop — PID 1 never exits
loop {
  msg = receivemessage /proc/1/inbox
  if msg == "shutdown" {
    out "[init] Shutdown received."
    reg /sys/init/status = "shutdown"
    exits "shutdown"
  }
  if msg == "reboot" {
    out "[init] Reboot received."
    reg /sys/init/status = "reboot"
    exits "reboot"
  }
}
