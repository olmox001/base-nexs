# services/ui/init.nx — Multi-Tasking Virtual TTY & UI
# ===================================================================
# Ogni processo ha il suo buffer video in PROC_BASE + "/vterm".
# ui_flip() sincronizza il buffer virtuale con il terminale fisico.

reg /sys/ui/width   = 80
reg /sys/ui/height  = 24

fn ui_init() {
  if type(PROC_BASE) == "err" { ret -1 }

  vterm = arr_create_anon()
  h = reg /sys/ui/height
  i = 0
  loop {
    if i >= h { break }
    arr_ins(vterm i "")
    i = i + 1
  }
  reg_set(PROC_BASE + "/vterm" vterm)
  ret 0
}

fn ui_at(y x txt) {
  vterm = reg_get(PROC_BASE + "/vterm")
  if type(vterm) == "err" { ret -1 }

  yi = y - 1
  vterm[yi] = txt
  ret 0
}


fn ui_cls() {
  vterm = reg_get(PROC_BASE + "/vterm")
  if type(vterm) == "err" { ret -1 }
  i = 0
  loop {
    if i >= len(vterm) { break }
    vterm[i] = ""
    i = i + 1
  }
}

fn ui_flip() {
  if !pm_is_fg(PROC_PID) { ret 0 }

  vterm = reg_get(PROC_BASE + "/vterm")
  if type(vterm) == "err" { ret -1 }

  term_cls()
  i = 0
  loop {
    if i >= len(vterm) { break }
    txt = vterm[i]
    if txt != "" {
      term_at(i + 1 1 txt)
    }
    i = i + 1
  }
  term_flush()
  ret 0
}

reg /sys/ui/status = "ready"
kout("[ui] Virtual TTY manager ready.")

exec("services/ui/img.nx")
