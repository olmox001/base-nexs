# services/ui/img.nx — Image Rendering Service
# Centralized rendering for .nxtimg (ANSI) assets.

fn ui_draw_image(path x y) {
  # Se x o y sono -1, non muovere il cursore (stampa inline)
  if x != -1 {
    if y != -1 {
      term_at(y x "")
    }
  }

  # Controllo sharding
  n_shards = reg_get("/sys/vfs/files/" + path + "@@n")
  if type(n_shards) != "err" {
    cnt = int(n_shards)
    j = 0
    loop {
      if j >= cnt { break }
      shard = reg_get("/sys/vfs/files/" + path + "@@" + str(j))
      if type(shard) != "err" {
        write(1 shard)
      }
      j = j + 1
    }
  } else {
    # File monolitico o chiave registry diretta
    data = reg_get("/sys/vfs/files/" + path)
    if type(data) == "err" {
      # Prova come path VFS diretto (se non inizia con /sys)
      data = vfs_read(path)
    }
    
    if type(data) != "err" {
      write(1 data)
    }
  }
  
  # Reset attributi terminale alla fine
  write(1 "\033[0m")
  ret 0
}

# Wrapper per caricamento loghi veloce
fn ui_draw_logo(name x y) {
  # Cerca in sd02/logos/ (nuovo mount sd02)
  ret ui_draw_image("sd02/logos/" + name + ".nxtimg" x y)
}

kout("[ui] Image rendering service loaded.")
