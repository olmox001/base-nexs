# services/pm/init.nx — NEXS Process & Memory Manager
# ===================================================================
# Sandboxed process execution with name mangling.
# Whitelist: system library functions are NOT mangled.

# Default process context; overridden by branch stdlib (FASE 7) or process spawn
PROC_PID  = -1
PROC_UID  = -1
PROC_BASE = "/sys/0/0"

reg /sys/pm/next_pid = 100
reg /sys/pm/fg_pid = -1

# System function prefixes that must NOT be mangled
PM_SYS_PREFIXES = "vfs_|fs_|pm_|auth_|tty_|ui_|hw_|p9_|tb_|ed_|nxed_|term_|logo_|kout|input|getcwd|chdir|cat|cp|mv|rm|mkdir|stat|basename|dirname|wc|replace_all|posix_|readkey|rawon|rawoff|write|read|open|close|create|out|eval|exec|exits|sleep|reg_|arr_|keys|split|replace|contains|substr|trim|upper|lower|len|type|str|int|float|abs|min|max|lines_of|print_reg|sendmessage|receivemessage|msgpending|mkptr|deref|fstat|seek|dup|fd2path|remove|pipe|bind|unmount|mount|alarm|rfork|await|getpid|getwd|chr|readbyte|set_layout|readkey_nb|buddy_stats|errstr|sys_debug|term_size|set_fg_pid|sys_bundled|arr_join|arr_ins|arr_del|arr_create_anon|shell_|get_proc_|PROC_"

fn _pm_is_system_fn(name) {
  # Check if a function name starts with a system prefix
  prefixes = split(PM_SYS_PREFIXES "|")
  i = 0
  loop {
    if i >= len(prefixes) { break }
    p = prefixes[i]
    if p != "" {
      pl = len(p)
      if len(name) >= pl {
        if substr(name 0 pl) == p { ret 1 }
      }
    }
    i = i + 1
  }
  ret 0
}

fn pm_mangle(uid pid code) {
  prefix = "_U" + str(uid) + "_P" + str(pid) + "_"
  lines = lines_of(code)

  # Pass 1: Find all user-defined function names (not system ones)
  names = arr_create_anon()
  ni = 0
  li = 0
  loop {
    if li >= len(lines) { break }
    line = trim(lines[li])
    if len(line) > 3 && substr(line 0 3) == "fn " {
      rest = substr(line 3 len(line)-3)
      p = 0
      loop {
        if p >= len(rest) { break }
        ch = substr(rest p 1)
        if ch == "(" || ch == " " { break }
        p = p + 1
      }
      fname = substr(rest 0 p)
      if fname != "" && !_pm_is_system_fn(fname) {
        arr_ins(names ni fname)
        ni = ni + 1
      }
    }
    li = li + 1
  }

  # Pass 2: Replace line by line
  new_code = ""
  li = 0
  loop {
    if li >= len(lines) { break }
    l = lines[li]
    i = 0
    loop {
      if i >= ni { break }
      fn_name = names[i]
      l = replace_all(l fn_name + "(" prefix + fn_name + "(")
      l = replace_all(l "fn " + fn_name "fn " + prefix + fn_name)
      i = i + 1
    }
    new_code = new_code + l + "\n"
    li = li + 1
  }
  ret new_code
}

# --- PID Resolver ---
fn pm_alloc_pid() {
  p = reg /sys/pm/next_pid
  loop {
    if type(reg_get("/sys/pm/procs/" + str(p) + "/base")) == "err" {
      reg /sys/pm/next_pid = p + 1
      ret p
    }
    p = p + 1
  }
}

# --- Process Database Registration ---
fn pm_register_proc(pid uid path window_id) {
  base = "/sys/" + str(uid) + "/" + str(pid)
  reg_set(base + "/uid" uid)
  reg_set(base + "/name" path)
  reg_set(base + "/state" "running")
  reg_set(base + "/window" window_id)

  # Global mapping
  reg_set("/sys/pm/procs/" + str(pid) + "/base" base)
  if window_id != -1 {
    reg_set("/sys/pm/sessions/" + str(window_id) pid)
  }

  # Inizializza Buffer Video Virtuale (24 righe vuote) per il Double Buffering
  vterm = arr_create_anon()
  vi = 0
  loop {
    if vi >= 24 { break }
    arr_ins(vterm vi "")
    vi = vi + 1
  }
  reg_set(base + "/vterm" vterm)
}


fn pm_spawn(uid path args) {
  # Quando apriamo un programma, cerchiamo uno slot finestra libero
  slot = -1
  i = 0
  loop {
    if i > 3 { break }
    p = reg_get("/sys/pm/sessions/" + str(i))
    if type(p) == "err" || p == -1 {
      slot = i
      break
    }
    i = i + 1
  }

  if slot == -1 {
    out "[PM] [ERR] Nessuno slot finestra disponibile per " + path
    ret -1
  }

  pid = pm_alloc_pid()

  # Namespace setup
  base = "/sys/" + str(uid) + "/" + str(pid)
  reg_set(base + "/args"  args)
  parent_cwd = "/"
  if type(PROC_BASE) == "str" {
    pc = reg_get(PROC_BASE + "/cwd")
    if type(pc) == "str" { parent_cwd = pc }
  }
  reg_set(base + "/cwd"   parent_cwd)
  reg_set(base + "/fg"    1)

  # Registro nel database processi e finestre
  pm_register_proc(pid uid path slot)

  kout("[PM] Spawned '" + path + "' [PID:" + str(pid) + ", Slot:" + str(slot) + "]")

  # Load code
  code = vfs_read(path)
  if type(code) == "err" || substr(code 0 4) == "ERR:" {
    kout("[PM] [ERR] Could not load program: " + path)
    pm_exit(pid)
    ret -1
  }

  # Esegui switch automatico alla nuova finestra
  reg /sys/pm/session_active = slot
  term_cls()

  # Save current context
  old_pid  = PROC_PID
  old_uid  = PROC_UID
  old_base = PROC_BASE

  # Inject process context + mangle
  ctx_header = "PROC_PID = " + str(pid) + "\n"
  ctx_header = ctx_header + "PROC_UID = " + str(uid) + "\n"
  ctx_header = ctx_header + "PROC_BASE = \"" + base + "\"\n"

  mangled_code = pm_mangle(uid pid code)

  # Restore context
  PROC_PID  = old_pid
  PROC_UID  = old_uid
  PROC_BASE = old_base

  pid_fork = rfork(reg /sys/rfork/RFPROC)
  if pid_fork == 0 {
    # Child Process: isolamento totale del buffer
    new_pid = getpid()

    reg /sys/pm/session_active = slot
    set_fg_pid(new_pid)
    term_cls()

    res = eval(ctx_header + mangled_code)

    if type(res) == "err" {
      out "[PM] [ERR] Process " + str(new_pid) + " crashed: " + str(res)
    }

    # Fix: scrivi stato exited nel registry PRIMA di exits()
    base = "/sys/" + str(uid) + "/" + str(new_pid)
    reg_set(base + "/state" "exited")
    pm_exit(new_pid)

    # Torna alla sessione 0 (shell principale)
    reg /sys/pm/session_active = 0
    term_cls()

    exits("")
  }

  # Parent returns immediately
  ret pid_fork
}



fn pm_exit(pid) {
  base = reg_get("/sys/pm/procs/" + str(pid) + "/base")
  if type(base) != "err" {
    reg_set(base + "/state" "exited")
  }
  reg_del("/sys/pm/procs/" + str(pid))

  # Pulisce lo slot se presente
  si = 0
  loop {
    if si > 3 { break }
    if reg_get("/sys/pm/sessions/" + str(si)) == pid {
      reg_set("/sys/pm/sessions/" + str(si) -1)
    }
    si = si + 1
  }

  kout("[PM] PID " + str(pid) + " exited.")
  ret 0
}



fn pm_ps() {
  out "  === NEXS Process Table ==="
  out "  PID   UID   STATE     NAME"
  out "  ---   ---   -----     ----"
  procs = keys("/sys/pm/procs/")
  i = 0
  loop {
    if i >= len(procs) { break }
    pid_key = procs[i]
    base = reg_get("/sys/pm/procs/" + pid_key + "/base")
    if type(base) != "err" {
      name = reg_get(base + "/name")
      uid  = reg_get(base + "/uid")
      stat = reg_get(base + "/state")
      fg   = reg_get(base + "/fg")
      if type(name) == "err" { name = "?" }
      if type(uid) == "err" { uid = "?" }
      if type(stat) == "err" { stat = "?" }
      fg_str = ""
      if fg == 1 { fg_str = " [FG]" }
      out "  " + str(pid_key) + "     " + str(uid) + "     " + str(stat) + "     " + str(name) + fg_str
    }
    i = i + 1
  }
}

# --- Session Management & Multiplexing ---
reg /sys/pm/session_active = 0
reg /sys/pm/sessions/0 = -1
reg /sys/pm/sessions/1 = -1
reg /sys/pm/sessions/2 = -1
reg /sys/pm/sessions/3 = -1

fn pm_is_fg(pid) {
  active_idx = reg /sys/pm/session_active
  active_pid = reg_get("/sys/pm/sessions/" + str(active_idx))
  if active_pid == pid { ret 1 }
  ret 0
}

fn pm_session_switch(dir) {
  cur = reg /sys/pm/session_active
  next = cur + dir
  if next < 0 { next = 3 }
  if next > 3 { next = 0 }

  reg /sys/pm/session_active = next
  active_pid = reg_get("/sys/pm/sessions/" + str(next))

  # Comunica al kernel il nuovo PID in primo piano (Focus Gating agnostico)
  set_fg_pid(active_pid)

  # Ripristina lo schermo dal buffer virtuale del processo se esiste
  if active_pid != -1 {
    base = reg_get("/sys/pm/procs/" + str(active_pid) + "/base")
    if type(base) != "err" {
      vterm = reg_get(base + "/vterm")
      if type(vterm) != "err" {
        term_cls()
        vi = 0
        loop {
          if vi >= len(vterm) { break }
          v_line = vterm[vi]
          if v_line != "" {
            term_at(vi + 1 1 v_line)
          }
          vi = vi + 1
        }
        term_flush()
      }
    }
  }

  # Verifica se il processo e' ancora valido
  is_valid = 0
  if type(active_pid) != "err" && active_pid != -1 {
    base = reg_get("/sys/pm/procs/" + str(active_pid) + "/base")
    if type(base) != "err" {
      state = reg_get(base + "/state")
      if state != "exited" { is_valid = 1 }
    }
  }

  term_cls()
  if is_valid == 0 {
    # Pulisce lo slot se il processo era morto
    reg_set("/sys/pm/sessions/" + str(next) -1)

    out "\n [ NEXS MULTIPLEXER ]"
    out " Slot " + str(next) + " e' vuoto."
    out ""
    out " Premi INVIO per caricare una nuova sessione..."
    out " o usa CTRL+Frecce per navigare."

    # Wait for ENTER or CTRL+Arrows (Robust ANSI parsing)
    loop {
      k = _readkey()
      if k == "" { continue }

      if k == chr(10) || k == chr(13) {
        pm_session_create_new(next)
        break
      }

      if k == chr(27) {
        s1 = readkey_nb(50)
        if s1 == "[" {
          s2 = readkey_nb(50)

          # Gestione \e[1;5C o \e[5C
          target_dir = ""
          if s2 == "5" {
            s3 = readkey_nb(50)
            if s3 == "C" { target_dir = "R" }
            if s3 == "D" { target_dir = "L" }
          }
          if s2 == "1" {
            readkey_nb(50)
            readkey_nb(50)
            s5 = readkey_nb(50)
            if s5 == "C" { target_dir = "R" }
            if s5 == "D" { target_dir = "L" }
          }

          if target_dir == "R" {
            pm_session_switch(1)
            break
          }
          if target_dir == "L" {
            pm_session_switch(-1)
            break
          }
        }
      }
    }

  } else {
    out "[PM] Switched to Session " + str(next) + " (PID " + str(active_pid) + ")"
  }
}

fn pm_session_create_new(slot) {
  term_cls()
  out "\n [ NUOVA SESSIONE ]"
  out " Seleziona utente:"

  users_all = keys("/sys/auth/users/")
  users = arr_create_anon()
  ui = 0
  loop {
    if ui >= len(users_all) { break }
    u_uid = users_all[ui]
    if u_uid != "0" {
      arr_ins(users len(users) u_uid)
    }
    ui = ui + 1
  }

  i = 0
  loop {
    if i >= len(users) { break }
    u_uid = users[i]
    u_name = reg_get("/sys/auth/users/" + u_uid + "/name")
    out " " + str(i) + ") " + u_name + " (UID " + u_uid + ")"
    i = i + 1
  }

  sel = input("Scelta (indice): ")
  idx = int(sel)
  if type(idx) == "err" || idx < 0 || idx >= len(users) {
    out "[ERR] Selezione non valida."
    sleep(1000)
    pm_session_switch(0)
    ret 0
  }

  target_uid = int(users[idx])

  # Password check for root (UID 1)
  if target_uid == 1 {
    pw = input("Password per root: ")
    if pw != "root" {
      out "[ERR] Password errata!"
      sleep(1000)
      pm_session_switch(0)
      ret 0
    }
  }

  pm_session_spawn_in_slot(slot target_uid "/example/minios/shell.nx")
}

fn pm_session_spawn_in_slot(slot uid path) {
  pid = pm_alloc_pid()

  pm_register_proc(pid uid path slot)

  res_fork = rfork(reg /sys/rfork/RFPROC)
  if res_fork == 0 {
    new_pid = getpid()
    reg_set("/sys/auth/uid" uid)

    PROC_UID = uid
    PROC_PID = new_pid
    PROC_BASE = "/sys/" + str(PROC_UID) + "/" + str(PROC_PID)
    reg_set(PROC_BASE + "/cwd" auth_get_home(PROC_UID))

    code = vfs_read(path)
    if type(code) == "err" { exits("") }

    mangled = pm_mangle(uid new_pid code)
    ctx = "PROC_PID = " + str(new_pid) + "\n"
    ctx = ctx + "PROC_UID = " + str(uid) + "\n"
    ctx = ctx + "PROC_BASE = \"" + PROC_BASE + "\"\n"

    if path == "/example/minios/shell.nx" {
      shell_loop()
    } else {
      eval(ctx + mangled)
    }
    exits("")
  } else {
    reg_set("/sys/pm/sessions/" + str(slot) res_fork)
    reg /sys/pm/session_active = slot
    set_fg_pid(res_fork)
    out "[PM] Sessione " + str(slot) + " avviata (PID " + str(res_fork) + ")"
    sleep(200)
  }
}


fn pm_session_spawn_auto(path) {
  slot = -1
  si = 0
  loop {
    if si > 3 { break }
    p = reg_get("/sys/pm/sessions/" + str(si))
    if p == -1 {
      slot = si
      break
    }
    si = si + 1
  }

  if slot == -1 {
    out "[PM] [ERR] Tutti gli slot sessione sono occupati."
    ret -1
  }

  uid = auth_get_uid()
  pm_session_spawn_in_slot(slot uid path)
  ret slot
}


fn pm_session_init() {
  pm_session_create_new(0)
}

reg /sys/pm/status = "ready"
kout("[pm] Process manager initialised.")
