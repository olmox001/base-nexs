# services/tty — Terminal / Console service
library "tty"
# Manages /sys/tty/<n>/ Virtual TTY buffers and console output.
# Mounted on sd01 as /mnt/sd01/services/tty/

reg /sys/tty/count = 0
reg /sys/tty/active = 0

fn tty_open(n) {
  p = "/sys/tty/" + str(n)
  reg_set(p + "/state" "open")
  reg /sys/tty/active = n
  ret n
}

fn tty_close(n) {
  p = "/sys/tty/" + str(n)
  reg_set(p + "/state" "closed")
  ret 0
}

fn tty_write(n s) {
  write(1 s)
  ret 0
}

fn tty_read(n) {
  ret readkey()
}

fn tty_set_raw(n on) {
  if on == 1 { rawon() } else { rawoff() }
  ret 0
}

fn tty_resize(n w h) {
  p = "/sys/tty/" + str(n)
  reg_set(p + "/cols" str(w))
  reg_set(p + "/rows" str(h))
  ret 0
}

reg /sys/tty/status = "ready"
out "[tty] TTY service initialised."
