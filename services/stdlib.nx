# services/stdlib.nx — NEXS Standard Library
# ===================================================================

fn input(prompt defval) {
  write(1 prompt)
  rawon()
  
  buffer = ""
  if type(defval) == "str" {
    buffer = defval
    write(1 buffer)
  }

  cur = len(buffer)

  loop {
    ch = readkey()
    if ch == "" { continue }
    
    if ch == "ENTER" {
      write(1 "\n")
      break
    }
    
    if ch == "BACKSPACE" {
      if cur > 0 {
        left = substr(buffer 0 cur - 1)
        right = substr(buffer cur len(buffer) - cur)
        buffer = left + right
        cur = cur - 1
        
        write(1 "\r\e[K" + prompt + buffer)
        diff = len(buffer) - cur
        if diff > 0 {
          write(1 "\e[" + str(diff) + "D")
        }
      }
      continue
    }

    if ch == "LEFT" || ch == "KEY_LEFT" {
      if cur > 0 {
        cur = cur - 1
        write(1 "\e[1D")
      }
      continue
    }

    if ch == "RIGHT" || ch == "KEY_RIGHT" {
      if cur < len(buffer) {
        cur = cur + 1
        write(1 "\e[1C")
      }
      continue
    }

    if ch == "HOME" || ch == "KEY_HOME" {
      if cur > 0 {
        write(1 "\e[" + str(cur) + "D")
        cur = 0
      }
      continue
    }
    
    if ch == "END" || ch == "KEY_END" {
      diff = len(buffer) - cur
      if diff > 0 {
        write(1 "\e[" + str(diff) + "C")
        cur = len(buffer)
      }
      continue
    }

    if ch == "UP" || ch == "KEY_UP" { continue }
    if ch == "DOWN" || ch == "KEY_DOWN" { continue }
    if ch == "ESC" { continue }
    if ch == "TAB" { continue }

    if len(ch) == 1 {
      left = substr(buffer 0 cur)
      right = substr(buffer cur len(buffer) - cur)
      buffer = left + ch + right
      cur = cur + 1
      
      write(1 "\r\e[K" + prompt + buffer)
      diff = len(buffer) - cur
      if diff > 0 {
        write(1 "\e[" + str(diff) + "D")
      }
    }
  }
  rawoff()
  ret buffer
}

# Nota: term_at, term_cls, term_cursor_move, ecc. sono built-in nativi (C)
# e non necessitano di wrapper nel modulo stdlib se usati direttamente.

fn cat(path) {
  ret vfs_read(path)
}

fn cp(src dst) {
  content = vfs_read(src)
  vfs_write(dst content)
  ret 0
}

fn mv(src dst) {
  cp(src dst)
  vfs_rm(src)
  ret 0
}

fn rm(path) {
  vfs_rm(path)
  ret 0
}

fn exists(path) {
  val = vfs_read(path)
  if type(val) == "err" {
    ret 0
  }
  ret 1
}
