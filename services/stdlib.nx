# services/stdlib.nx — NEXS Standard Library
# ===================================================================

fn input(prompt defval) {
  write(1 prompt)
  rawon()
  
  buffer = ""
  if type(defval) == "str" {
    buffer = defval
    write(1 buffer)
  }

  loop {
    ch = readkey()
    if ch == "" { continue }
    
    if ch == "ENTER" {
      write(1 "\n")
      break
    }
    
    if ch == "BACKSPACE" {
      blen = len(buffer)
      if blen > 0 {
        write(1 "\b \b")
        buffer = substr(buffer 0 blen - 1)
      }
      continue
    }

    # Gestione esplicita tasti speciali per evitare che finiscano nel buffer
    if ch == "UP" || ch == "KEY_UP" { continue }
    if ch == "DOWN" || ch == "KEY_DOWN" { continue }
    if ch == "LEFT" || ch == "KEY_LEFT" { continue }
    if ch == "RIGHT" || ch == "KEY_RIGHT" { continue }
    if ch == "HOME" || ch == "KEY_HOME" { continue }
    if ch == "END" || ch == "KEY_END" { continue }
    if ch == "ESC" { continue }
    if ch == "TAB" { continue }

    if len(ch) == 1 {
      write(1 ch)
      buffer = buffer + ch
    }
  }
  rawoff()
  ret buffer
}

# Nota: term_at, term_cls, term_cursor_move, ecc. sono built-in nativi (C)
# e non necessitano di wrapper nel modulo stdlib se usati direttamente.

fn cat(path) {
  ret vfs_read(path)
}

fn cp(src dst) {
  content = vfs_read(src)
  vfs_write(dst content)
  ret 0
}

fn mv(src dst) {
  cp(src dst)
  vfs_rm(src)
  ret 0
}

fn rm(path) {
  vfs_rm(path)
  ret 0
}

fn exists(path) {
  val = vfs_read(path)
  if type(val) == "err" {
    ret 0
  }
  ret 1
}
