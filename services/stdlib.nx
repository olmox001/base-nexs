# services/stdlib.nx — NEXS Standard Library (unified)
library "stdlib"

# Global Context Stubs (Overridden by pm_spawn)
PROC_PID  = -1
PROC_UID  = -1
PROC_BASE = "/sys/0/0"

# --- ANSI Key Parser (Userspace) ---
fn readkey() {
  loop {
    pid = getpid()
    
    # Focus check: solo il processo nella finestra attiva legge i tasti.
    if pid >= 100 {
      active_idx = reg /sys/pm/session_active
      active_pid = reg_get("/sys/pm/sessions/" + str(active_idx))
      if active_pid != pid {
        sleep(200)
        continue
      }
    }

    raw = _readkey()
    if raw == "" { continue }
    
    # Se è un tasto speciale ritornato dal kernel (ENTER, BACKSPACE)
    if raw == "ENTER" || raw == "BACKSPACE" || raw == "CTRL_X" { ret raw }
    
    # Se è l'inizio di una sequenza ANSI (ESC = \e)
    if raw == chr(27) {
      # Prova a leggere il prossimo carattere (non-blocking)
      seq1 = readkey_nb(50)
      if seq1 == "" { ret "ESC" }
      
      if seq1 == "[" {
        s2 = readkey_nb(50)
        
        # Gestione \e[1;5C o \e[5C
        target_dir = ""
        if s2 == "5" { # \e[5C
          s3 = readkey_nb(50)
          if s3 == "C" { target_dir = "R" }
          if s3 == "D" { target_dir = "L" }
        }
        if s2 == "1" { # \e[1;5C
          readkey_nb(50) # ;
          readkey_nb(50) # 5
          s5 = readkey_nb(50)
          if s5 == "C" { target_dir = "R" }
          if s5 == "D" { target_dir = "L" }
        }
        
        if target_dir == "R" {
          pm_session_switch(1)
          continue
        }
        if target_dir == "L" {
          pm_session_switch(-1)
          continue
        }
        
        if s2 == "A" { ret "KEY_UP" }
        if s2 == "B" { ret "KEY_DOWN" }
        if s2 == "C" { ret "KEY_RIGHT" }
        if s2 == "D" { ret "KEY_LEFT" }

      }
      
      if seq1 == "O" {
        seq2 = readkey_nb(50)
        if seq2 == "A" { ret "KEY_UP" }
        if seq2 == "B" { ret "KEY_DOWN" }
        if seq2 == "C" { ret "KEY_RIGHT" }
        if seq2 == "D" { ret "KEY_LEFT" }
      }
      
      ret "ESC"
    }

    ret raw
  }
}

# --- Terminal Shadowing (Double Buffering) ---
fn term_at(y x txt) {
  if type(PROC_BASE) != "err" {
    vterm = reg_get(PROC_BASE + "/vterm")
    if type(vterm) != "err" {
      if y >= 1 && y <= 24 {
        yi = y - 1
        vterm[yi] = txt
      }
    }
  }
  _term_at(y x txt)
}

fn term_cls() {
  if type(PROC_BASE) != "err" {
    vterm = reg_get(PROC_BASE + "/vterm")
    if type(vterm) != "err" {
      vi = 0
      loop {
        if vi >= len(vterm) { break }
        vterm[vi] = ""
        vi = vi + 1
      }
    }
  }
  _term_cls()
}


fn term_flush() { _term_flush() }
fn term_cursor_move(y x) { _term_cursor_move(y x) }
fn term_cursor_show(b) { _term_cursor_show(b) }
fn term_size() { ret "80x24" }


fn input(prompt defval) {
  write(1 prompt)
  rawon()
  
  buffer = ""
  if type(defval) == "str" {
    buffer = defval
    write(1 buffer)
  }

  cur = len(buffer)

  loop {
    ch = readkey()
    
    if ch == "ENTER" {
      write(1 "\n")
      break
    }
    
    if ch == "BACKSPACE" {
      if cur > 0 {
        left = substr(buffer 0 cur - 1)
        right = substr(buffer cur len(buffer) - cur)
        buffer = left + right
        cur = cur - 1
        
        write(1 "\r\e[K" + prompt + buffer)
        diff = len(buffer) - cur
        if diff > 0 {
          write(1 "\e[" + str(diff) + "D")
        }
      }
      continue
    }

    if ch == "LEFT" || ch == "KEY_LEFT" {
      if cur > 0 {
        cur = cur - 1
        write(1 "\e[1D")
      }
      continue
    }

    if ch == "RIGHT" || ch == "KEY_RIGHT" {
      if cur < len(buffer) {
        cur = cur + 1
        write(1 "\e[1C")
      }
      continue
    }

    if ch == "HOME" || ch == "KEY_HOME" {
      if cur > 0 {
        write(1 "\e[" + str(cur) + "D")
        cur = 0
      }
      continue
    }
    
    if ch == "END" || ch == "KEY_END" {
      diff = len(buffer) - cur
      if diff > 0 {
        write(1 "\e[" + str(diff) + "C")
        cur = len(buffer)
      }
      continue
    }

    if ch == "UP" || ch == "KEY_UP" { continue }
    if ch == "DOWN" || ch == "KEY_DOWN" { continue }
    if ch == "ESC" || ch == "\e" || ch == "\x1b" { 
      write(1 "\n")
      ret nil 
    }
    if ch == "TAB" { continue }

    if len(ch) == 1 {
      left = substr(buffer 0 cur)
      right = substr(buffer cur len(buffer) - cur)
      buffer = left + ch + right
      cur = cur + 1
      
      write(1 "\r\e[K" + prompt + buffer)
      diff = len(buffer) - cur
      if diff > 0 {
        write(1 "\e[" + str(diff) + "D")
      }
    }
  }
  rawoff()
  ret buffer
}

# --- Process & Sandboxing Helpers ---
fn get_proc_pid()  { ret PROC_PID }
fn get_proc_uid()  { ret PROC_UID }
fn get_proc_base() { ret PROC_BASE }

fn pm_is_fg(pid) {
  if pid < 100 { ret 1 }
  fg = reg_get("/sys/kernel/fg_pid")
  if type(fg) == "err" { ret 1 }
  if fg == pid { ret 1 }
  ret 0
}


# --- VFS & POSIX-like API ---
# vfs_exists is defined in fs/init.nx — do NOT redefine here

fn posix_read(path)          { ret vfs_read(path) }
fn posix_write(path content) { ret vfs_write(path content) }

fn stat(path) {
  if !vfs_exists(path) { ret nil }
  nome = vfs_normalize_path(path)
  info = arr_create_anon()
  arr_ins(info 0 "file")
  ns = reg_get("/sys/vfs/files/" + nome + "@@n")
  if type(ns) != "err" {
    sz = 0
    j = 0
    cnt = int(ns)
    loop {
      if j >= cnt { break }
      s = reg_get("/sys/vfs/files/" + nome + "@@" + str(j))
      if type(s) != "err" { sz = sz + len(s) }
      j = j + 1
    }
    arr_ins(info 1 sz)
  } else {
    v = reg_get("/sys/vfs/files/" + nome)
    if type(v) != "err" { arr_ins(info 1 len(v)) }
    else { arr_ins(info 1 0) }
  }
  ret info
}

fn basename(path) {
  if path == "" || path == "/" { ret "/" }
  if substr(path len(path)-1 1) == "/" { path = substr(path 0 len(path)-1) }
  i = len(path) - 1
  loop {
    if i < 0 { break }
    if substr(path i 1) == "/" { ret substr(path i+1 len(path)-i-1) }
    i = i - 1
  }
  ret path
}

fn dirname(path) {
  if path == "" || path == "/" { ret "/" }
  if substr(path len(path)-1 1) == "/" { path = substr(path 0 len(path)-1) }
  i = len(path) - 1
  loop {
    if i < 0 { break }
    if substr(path i 1) == "/" {
      if i == 0 { ret "/" }
      ret substr(path 0 i)
    }
    i = i - 1
  }
  ret "."
}

fn wc(path) {
  data = vfs_read(path)
  if type(data) == "err" { ret -1 }
  lines = split(data "\n")
  ret len(lines)
}

fn mkdir(path) {
  vfs_mkdir(path)
  ret 0
}

# Alias per navigazione (usano il registry PROC_BASE/cwd)
fn getcwd() {
  ret reg_get(get_proc_base() + "/cwd")
}

fn sys_chdir(path) {
  reg_set(get_proc_base() + "/cwd" path)
  ret 0
}

fn cat(path) {
  data = vfs_read(path)
  if type(data) != "err" && substr(data 0 4) != "ERR:" { out data }
  else { out "cat: " + path + ": file non trovato" }
}

fn cp(src dst) {
  ret vfs_cp(src dst)
}

fn mv(src dst) {
  ret vfs_mv(src dst)
}

fn rm(path) {
  vfs_rm(path)
  ret 0
}

# --- System Control ---
fn sys_shutdown() {
  # Invia segnale di spegnimento al processo init (PID 1)
  sendmessage("/proc/1/inbox" "shutdown")
}

# Output condizionale (usato dai servizi per rispettare debug=0/1)

# Gli errori [ERR] e i [WARN] vengono mostrati sempre per sicurezza.
fn kout(msg) {
  d = reg_get("/sys/config/debug")
  
  is_crit = 0
  if type(msg) == "err" { is_crit = 1 }
  if startswith(msg "[ERR]")   { is_crit = 1 }
  if startswith(msg "[WARN]")  { is_crit = 1 }
  if startswith(msg "  [ERR]") { is_crit = 1 }
  if startswith(msg "  [WARN]"){ is_crit = 1 }

  _pm_status = reg_get("/sys/pm/status")
  if _pm_status == "ready" {
    _cur_pid = getpid()
    if _cur_pid >= 100 {
      active_idx = reg /sys/pm/session_active
      active_pid = reg_get("/sys/pm/sessions/" + str(active_idx))
      if active_pid != _cur_pid && is_crit == 0 {
        ret 0
      }
    }
  }

  if (type(d) == "err" || d == 1 || is_crit == 1) {
    out msg
  }
}

fn replace_all(s old new) {
  if old == "" { ret s }
  parts = split(s old)
  res = ""
  i = 0
  loop {
    if i >= len(parts) { break }
    if i > 0 { res = res + new }
    res = res + parts[i]
    i = i + 1
  }
  ret res
}

# Helper: strip leading slash for VFS registry lookup
fn vfs_normalize_path(path) {
  if path == "" { ret "" }
  if substr(path 0 1) == "/" { ret substr(path 1 len(path)-1) }
  ret path
}

fn exists(path) {
  ret vfs_exists(path)
}

fn clamp(v lo hi) {
  if v < lo { ret lo }
  if v > hi { ret hi }
  ret v
}

fn join(arr sep) {
  ret arr_join(arr sep)
}
