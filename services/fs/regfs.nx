# services/fs/regfs.nx — Registry File System Serialization
library "regfs"
# ===================================================================

fn regfs_save(path_in_reg file_path) {
  fd = open(file_path 1)
  if fd < 0 { ret -1 }

  # Iterative DFS — avoids recursive stack overflow on deep trees
  stack = arr_create_anon(1)
  arr_ins(stack 0 path_in_reg)

  loop {
    if len(stack) == 0 { break }
    current_path = stack[0]
    arr_del(stack 0)

    v = reg_get(current_path)
    t = type(v)
    if t != "err" && t != "nil" && t != "arr" && t != "ptr" && t != "fn" {
      line = t + "|" + current_path + "|" + str(v) + "\n"
      write(fd line)
    }

    children = keys(current_path)
    len_c = len(children)
    # Push children in reverse order so they are visited in forward order
    i = len_c - 1
    loop {
      if i < 0 { break }
      child_name = children[i]
      if current_path == "/" {
        child_path = "/" + str(child_name)
      } else {
        child_path = str(current_path) + "/" + str(child_name)
      }
      arr_ins(stack 0 child_path)
      i = i - 1
    }
  }

  close(fd)
  ret 0
}

fn regfs_load(file_path) {
  fd = open(file_path 0)
  if fd < 0 { ret -1 }

  content = read(fd 65536)
  close(fd)

  lines = split(content "\n")
  count = len(lines)
  i = 0
  loop {
    if i >= count { break }
    line = lines[i]
    if len(line) > 0 {
      parts = split(line "|")
      if len(parts) >= 3 {
        vtype = parts[0]
        vpath = parts[1]
        vval_str = parts[2]

        if vtype == "int"   { reg_set(vpath int(vval_str)) }
        if vtype == "str"   { reg_set(vpath vval_str) }
        if vtype == "float" { reg_set(vpath float(vval_str)) }
        if vtype == "bool" {
          if vval_str == "true" { reg_set(vpath true) }
          else                  { reg_set(vpath false) }
        }
      }
    }
    i = i + 1
  }

  ret 0
}
