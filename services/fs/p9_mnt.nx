# services/fs/p9_mnt.nx — Plan 9 Namespace & VFS Population
# ===================================================================
# Imports host files into the VFS and creates the directory structure.
# Called once during boot after all services are loaded.

fn p9_mnt_init() {
  kout("[P9] Popolamento filesystem (/System, /Applications, /Users)...")

  # --- /System/Library: CORE LIBRARIES ---
  vfs_import("services/stdlib.nx"      "System/Library/stdlib.nx")
  vfs_import("services/fs/init.nx"     "System/Library/fs.nx")
  vfs_import("services/pm/init.nx"     "System/Library/pm.nx")
  vfs_import("services/auth/init.nx"   "System/Library/auth.nx")
  vfs_import("services/tty/init.nx"    "System/Library/tty.nx")
  vfs_import("services/ui/init.nx"     "System/Library/ui.nx")
  vfs_import("services/ui/img.nx"      "System/Library/ui_img.nx")
  vfs_import("services/textbuf.nx"     "System/Library/textbuf.nx")
  vfs_import("services/hw_dt.nx"       "System/Library/hw_dt.nx")
  vfs_import("services/logos/init.nx"  "System/Library/logos.nx")
  vfs_import("services/fs/regfs.nx"    "System/Library/regfs.nx")

  # --- /Applications: USER-FACING PROGRAMS ---
  vfs_import("example/minios/nxed_editor.nx" "Applications/nxed.nx")
  vfs_import("example/minios/termimg.nx"     "Applications/termimg.nx")
  vfs_import("example/minios/shell.nx"       "Applications/shell.nx")

  # --- /Users: HOME DIRECTORIES ---
  # Root home
  vfs_mkdir("Users/root/")
  vfs_mkdir("Users/root/Documents/")

  # Standard user home
  vfs_mkdir("Users/user/")
  vfs_mkdir("Users/user/Documents/")
  vfs_mkdir("Users/user/Pictures/")
  vfs_write("Users/user/welcome.txt" "Benvenuto nel tuo spazio personale NEXS.\nLe app sono in /Applications, il sistema in /System.\nUsa 'help' per la lista dei comandi.")

  # Guest home
  vfs_mkdir("Users/guest/")
  vfs_mkdir("Users/guest/logos/")

  # --- /etc: SYSTEM CONFIG ---
  vfs_mkdir("etc/")
  vfs_write("etc/hostname" "nexs-os")
  vfs_write("etc/motd" "NEXS Modular Microkernel OS\nType 'help' for available commands.")

  kout("[P9] VFS populated successfully.")
}

fn p9_file_manager(dir) {
  out "=== NEXS P9 FILE MANAGER [" + dir + "] ==="
  vfs_ls(dir)
}
