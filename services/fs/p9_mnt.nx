# services/fs/p9_mnt.nx — Plan 9 Namespace Mounts
# ===================================================================

fn p9_mnt_init() {
  kout("[P9] Montaggio delle gerarchie di sistema...")

  # Setup logical nodes in VFS
  vfs_write("krnl/registry/type"   "Plan 9 Virtual Kernel Registry")
  vfs_write("krnl/registry/status" "active")
  
  vfs_write("system/services"     "VFS_Daemon, Shell_TTY, Wasm_VM")
  vfs_write("system/config"       "INIT_MODE=STANDALONE\nFS=Plan9")
  
  vfs_write("driver/tty0"         "COM1 Serial Terminal")
  vfs_write("driver/ram"          "Dynamic Micro-kernel Memory Pool")
  
  # SD storage (machine maps)
  vfs_write("sd00/boot.nx"        "exec(\"example/minios/boot.nx\")")
  vfs_write("sd00/os.sys"         "NEXS CORE KERNEL BLOCK")
  vfs_write("sd00/machine.id"     "NEXS-NODE-00")
  
  vfs_write("sd01/user.id"        "User-1-Root")
  vfs_write("sd01/home/root.txt"  "Root workspace")

  vfs_write("sd02/user.id"        "User-2-user1")
  vfs_write("sd02/home/user1.txt"  "Ciao user1! Benvenuto.")

  # Cartella loghi sempre visibile in `ls sd02` (init_logos aggiunge i .nxtimg dopo)
  vfs_mkdir("sd02/logos/")
  vfs_write("sd02/logos/README.txt" "Immagini .nxtimg (sharded @@i / monolite). Vedi init_logos.nx e termimg.\n")

  vfs_write("sd99/user.id"        "User-Guest")
  vfs_write("sd99/tmp/test"       "Temporary guest cache")

  kout("[P9] Hierarchy mounted successfully via 9P bindings.")
}

fn p9_file_manager(dir) {
  out "=== NEXS P9 FILE MANAGER [" + dir + "] ==="
  vfs_ls(dir)
}
