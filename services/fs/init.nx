# services/fs — Filesystem / VFS service
# Manages mount table at /sys/fs/mounts/ and exports helpers.
# sd00 = drivers, sd01 = system, sd02 = root apps, sd03-97 = users,
# sd98 = guest, sd99 = cache.

reg /sys/fs/mount_count = 0

fn fs_mount(src dst fstype) {
  n = reg /sys/fs/mount_count
  p = "/sys/fs/mounts/" + str(n)
  reg_set(p + "/src"    src)
  reg_set(p + "/dst"    dst)
  reg_set(p + "/fstype" fstype)
  reg_set(p + "/state"  "mounted")
  mount(src dst 0)
  reg /sys/fs/mount_count = n + 1
  out "[fs] Mounted " + src + " -> " + dst + " (" + fstype + ")"
  ret n
}

fn fs_umount(dst) {
  unmount("" dst)
  out "[fs] Unmounted " + dst
  ret 0
}

fn fs_sync() {
  out "[fs] Syncing..."
  ret 0
}

fn fs_stat(path) {
  ret fstat(path)
}

# Initialise standard POSIX-style mount namespace
fs_mount("/sys/registry" "/reg"      "regfs")
fs_mount("/sd00"         "/dev"      "drivers")
fs_mount("/sd01"         "/usr"      "system")
fs_mount("/sd02"         "/apps"     "regfs")
fs_mount("/sd98"         "/guest"    "regfs")
fs_mount("/sd99"         "/cache"    "regfs")

fn vfs_cp(src, dst) {
    var data = vfs_read(src)
    if (type(data) != "err") {
        vfs_write(dst, data)
    }
}

fn vfs_mv(src, dst) {
    vfs_cp(src, dst)
    vfs_rm(src)
}


# Initialize VFS hierarchy
vfs_mkdir("/system")
vfs_mkdir("/usr")
vfs_mkdir("/dev")
vfs_mkdir("/home")

# Set initial VFS CWD
reg_set("/proc/1/vfs_cwd" "/")

reg /sys/fs/status = "ready"
out "[fs] Filesystem service initialised."
