# services/fs — Filesystem / VFS service
library "fs"
# Manages mount table at /sys/fs/mounts/ and exports helpers.
# sd00 = drivers, sd01 = sys, sd02 = root apps, sd03-97 = users,
# sd98 = guest, sd99 = cache.

reg /sys/fs/mount_count = 0

fn fs_mount(src dst fstype) {
  n = reg /sys/fs/mount_count
  p = "/sys/fs/mounts/" + str(n)
  reg_set(p + "/src"    src)
  reg_set(p + "/dst"    dst)
  reg_set(p + "/fstype" fstype)
  # reg_set(p + "/state"  "mounted")
  mount(src dst 0)
  reg /sys/fs/mount_count = n + 1
  ret n
}

fn fs_umount(dst) {
  unmount("" dst)
  ret 0
}

fn fs_sync() {
  ret 0
}

fn fs_stat(path) {
  ret fstat(path)
}

# Initialise standard POSIX-style mount namespace
fs_mount("/sd00"         "/sd00"     "drivers")
fs_mount("/sd01"         "/sd01"     "system")
fs_mount("/sd02"         "/sd02"     "regfs")
fs_mount("/sd98"         "/sd98"     "regfs")
fs_mount("/sd99"         "/sd99"     "regfs")

# Registry mount (nested in system disk)
fs_mount("/sys/registry" "/sd01/sys/registry" "regfs")

# VFS logic (integrated)
reg /sys/vfs/count = 0


fn vfs_write(nome_file contenuto) {
  count = reg /sys/vfs/count
  # Verifica rapida dell'esistenza per evitare loop costosi nel registro
  esistente = reg_get("/sys/vfs/files/" + nome_file)
  if type(esistente) != "err" {
    reg_set("/sys/vfs/files/" + nome_file, contenuto)
    ret nil
  }
  reg_set("/sys/vfs/files/" + nome_file, contenuto)
  reg_set("/sys/vfs/idx/" + str(count), nome_file)
  reg /sys/vfs/count = count + 1
}

fn vfs_read(nome_file) {
  val = reg_get("/sys/vfs/files/" + nome_file)
  if type(val) == "err" || startswith(val "BUNDLED") {
    # Fallback: check embedded bundle
    orig_path = nome_file
    if startswith(val "BUNDLED:") {
       orig_path = substr(val 8 len(val) - 8)
    }
    val = sys_embedded_read(orig_path)
    if type(val) == "err" {
       ret "ERR: File '" + nome_file + "' non trovato"
    }
  }
  ret val
}

fn vfs_resolve(path cwd) {
  if path == "" { ret cwd }
  if substr(path 0 1) == "/" { ret substr(path 1 len(path)-1) }
  if cwd == "" || cwd == "/" { ret path }
  if substr(cwd 0 1) == "/" { cwd = substr(cwd 1 len(cwd)-1) }
  ret cwd + "/" + path
}

fn vfs_rm(nome_file) {
  reg_del("/sys/vfs/files/" + nome_file)
  count = reg /sys/vfs/count
  i = 0
  loop {
    if i >= count { break }
    slot_key = "/sys/vfs/idx/" + str(i)
    if reg_get(slot_key) == nome_file {
      reg_set(slot_key "")
      break
    }
    i = i + 1
  }
}

fn vfs_mkdir(nome_dir) {
  # Se il percorso non termina con /, lo aggiungiamo
  if substr(nome_dir len(nome_dir) - 1 1) != "/" {
    nome_dir = nome_dir + "/"
  }
  
  # Verifichiamo se esiste già (opzionale, ma consigliato)
  # Per ora aggiungiamo semplicemente all'indice
  count = reg /sys/vfs/count
  reg_set("/sys/vfs/idx/" + str(count), nome_dir)
  reg /sys/vfs/count = count + 1
}

fn vfs_cp(src dst) {
  data = vfs_read(src)
  if type(data) != "err" {
    vfs_write(dst data)
  }
}

fn vfs_mv(src dst) {
  vfs_cp(src dst)
  vfs_rm(src)
}

fn vfs_ls(dir) {
  # Normalizzazione dir
  if dir == "" || dir == "/" {
    dir = ""
    out "  === VFS [/] ==="
  } else {
    # Rimuovi leading / se presente
    if substr(dir 0 1) == "/" { dir = substr(dir 1 len(dir)-1) }
    out "  === VFS [" + dir + "] ==="
  }
  
  prefix = dir
  if prefix != "" { prefix = prefix + "/" }
  plen = len(prefix)
  
  found_any = 0
  if dir == "" { found_any = 1 } # Root exists always

  seen_dirs = "|"
  count = reg /sys/vfs/count
  i = 0
  loop {
    if i >= count { break }
    n = reg_get("/sys/vfs/idx/" + str(i))
    if n != "" {
      # Controllo se il file è nel path richiesto
      match = 0
      if dir == "" {
        match = 1
      } else {
        if substr(n 0 plen) == prefix {
          match = 1
        }
      }
      
      if match == 1 {
        found_any = 1
        rest = substr(n plen len(n) - plen)
        # Se rest contiene "/", allora è in una sottodirectory
        slash_pos = -1
        j = 0
        loop {
          if j >= len(rest) { break }
          if substr(rest j 1) == "/" {
            slash_pos = j
            break
          }
          j = j + 1
        }
        
        if slash_pos != -1 {
          # È una directory
          dname = substr(rest 0 slash_pos)
          if !contains(seen_dirs "|" + dname + "|") {
            out "  [DIR]  " + dname + "/"
            seen_dirs = seen_dirs + dname + "|"
          }
        } else {
          # È un file
          if rest != "" {
            out "  [FILE] " + rest
          }
        }
      }
    }
    i = i + 1
  }

  # --- New: Dynamic Mount Points Scanning ---
  mcount = reg /sys/fs/mount_count
  if type(mcount) != "err" {
    mi = 0
    loop {
      if mi >= mcount { break }
      mdst = reg_get("/sys/fs/mounts/" + str(mi) + "/dst")
      if type(mdst) == "str" && mdst != "" {
        # mdst is like "/reg" or "/dev". Remove leading slash for matching
        mpath = mdst
        if substr(mdst 0 1) == "/" { mpath = substr(mdst 1 len(mdst)-1) }
        
        # Check if this mount is inside our current listing dir
        is_match = 0
        if dir == "" {
          is_match = 1
        } else {
          if startswith(mpath prefix) { is_match = 1 }
        }

        if is_match == 1 {
          found_any = 1
          # Extract the component name relative to current dir
          mrest = substr(mpath plen len(mpath) - plen)
          # Get only the first segment
          slash_idx = -1
          sk = 0
          loop {
            if sk >= len(mrest) { break }
            if substr(mrest sk 1) == "/" {
              slash_idx = sk
              break
            }
            sk = sk + 1
          }
          
          mname = mrest
          if slash_idx != -1 { mname = substr(mrest 0 slash_idx) }
          
          if mname != "" {
            if !contains(seen_dirs "|" + mname + "|") {
              out "  [MNT]  " + mname + "/"
              seen_dirs = seen_dirs + mname + "|"
            }
          }
        }
      }
      mi = mi + 1
    }
  }

  if found_any == 0 {
    # Restituiamo un errore del registry per far scattare type() == "err"
    ret reg_get("/sys/vfs/errors/not_found")
  }
}

fn vfs_exists(path) {
  val = reg_get("/sys/vfs/files/" + path)
  if type(val) != "err" { ret 1 }
  val = sys_embedded_read(path)
  if type(val) != "err" { ret 1 }
  ret 0
}

fn vfs_import(host_path vfs_path) {
  fd = open(host_path 0)
  if type(fd) == "err" { ret 0 }
  chunk_size = 4096
  shard_idx = 0
  total = 0
  loop {
    chunk = read(fd chunk_size)
    if type(chunk) == "err" { break }
    if len(chunk) == 0 { break }
    reg_set("/sys/vfs/files/" + vfs_path + "@@" + str(shard_idx) chunk)
    total = total + len(chunk)
    shard_idx = shard_idx + 1
    if len(chunk) < chunk_size { break }
  }
  close(fd)
  if shard_idx > 0 {
    reg_set("/sys/vfs/files/" + vfs_path + "@@n" str(shard_idx))
    count = reg /sys/vfs/count
    reg_set("/sys/vfs/idx/" + str(count) vfs_path)
    reg /sys/vfs/count = count + 1
  }
  ret total
}

reg /sys/fs/status = "ready"
# out "[fs] Filesystem service initialised."
