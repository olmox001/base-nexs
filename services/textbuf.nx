# services/textbuf — Text Buffer utility library
library "textbuf"
# Helper functions for line-based text editing.
# ===================================================================

fn tb_create() {
  buf = arr_create_anon()
  arr_ins(buf 0 "")
  ret buf
}

fn tb_get_line(buf y) {
  v = buf[y]
  if type(v) == "err" { ret "" }
  ret str(v)
}

fn tb_set_line(buf y txt) {
  buf[y] = txt
}

fn tb_insert_char(buf y x ch) {
  txt = tb_get_line(buf y)
  l = len(txt)
  p1 = substr(txt 0 x)
  p2 = substr(txt x l - x)
  tb_set_line(buf y p1 + ch + p2)
}

fn tb_delete_char(buf y x) {
  txt = tb_get_line(buf y)
  l = len(txt)
  if x <= 0 { ret 0 }
  p1 = substr(txt 0 x - 1)
  p2 = substr(txt x l - x)
  tb_set_line(buf y p1 + p2)
  ret 1
}

fn tb_split_line(buf y x) {
  txt = tb_get_line(buf y)
  l = len(txt)
  p1 = substr(txt 0 x)
  p2 = substr(txt x l - x)
  tb_set_line(buf y p1)
  arr_ins(buf y + 1 p2)
}

fn tb_merge_line(buf y) {
  if y <= 0 { ret 0 }
  prev = tb_get_line(buf y - 1)
  curr = tb_get_line(buf y)
  tb_set_line(buf y - 1 prev + curr)
  arr_del(buf y)
  ret len(prev)
}

fn tb_load(buf content) {
  # Pulisce buffer
  loop {
    if len(buf) <= 0 { break }
    arr_del(buf 0)
  }
  lines = split(content "\n")
  n = len(lines)
  if n == 0 {
    arr_ins(buf 0 "")
    ret 1
  }
  i = 0
  loop {
    if i >= n { break }
    arr_ins(buf i lines[i])
    i = i + 1
  }
  ret n
}

fn tb_to_str(buf) {
  ret arr_join(buf "\n")
}
