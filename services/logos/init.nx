# services/logos/init.nx — Carica i loghi nel VFS (sd02/logos)
# Eseguito durante il boot di minios per rendere disponibili le immagini .nxtimg

kout("[INIT] Caricamento loghi nel VFS...")

# Leggi i loghi da sd02/logos e popola il VFS
# Questo assume che i file .nxtimg siano già compilati e disponibili

# Funzione per registrare un logo nel registry per quick access
fn logo_register(logo_name logo_path) {
  reg_set("/sys/logos/" + logo_name, logo_path)
  kout("  [Logo] " + logo_name + " → " + logo_path)
}

# Registra i loghi standard (allineato a init_logos: boot su logo1)
logo_register("nexs-feather", "sd02/logos/logo1.nxtimg")
logo_register("system-splash", "sd02/logos/logo1.nxtimg")

kout("[INIT] Loghi caricati nel registry (/sys/logos/*).")
