# nxlib/services/fs/p9_mnt — Plan 9 Mount Manager
library "p9_mnt"
# Manages system hierarchy using Plan 9 / VFS integration.
# ===================================================================

# Plan 9 attach/mount only accepts a real provider and authenticated
# domain namespace capability. The former body manufactured sd00/sd01/
# sd02/sd99 nodes and fake hardware/driver information with vfs_write().
# Do not create any pseudo-hardware or grant access by publishing names.
# The eventual Pgrp/Chan/Dev provider will supply these existing roots.
fn p9_mnt_init() {
  ret -1
}

fn p9_file_manager(dir) {
  out "=== NEXS P9 FILE MANAGER [" + dir + "] ==="
  vfs_ls(dir)
}
