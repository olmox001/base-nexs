# nxlib/services/fs/init.nx — optional filesystem MOUNT service.
# The actual file/namespace API lives ONLY in nxlib/fs.nx.
# Loading the image is not permission to start a privileged service.
library "fs_service"
import "nxlib/fs.nx"

# Mount/bind require an authenticated namespace owner and a real provider.
# Do not manufacture /sys/fs/mounts records or treat a filename as a grant.
fn fs_mount(src dst fstype) {
  result = mount(src dst 0)
  if type(result) == "err" || result != 0 { ret -1 }
  ret 0
}

fn fs_umount(dst) {
  result = unmount("" dst)
  if type(result) == "err" || result != 0 { ret -1 }
  ret 0
}

fn fs_sync() {
  # No durable synchronization provider has been admitted yet.
  ret -1
}

fn fs_stat(path) {
  ret stat(path)
}

fn fs_start() {
  # A namespace owner must explicitly select and authorize every mount.
  # Do not synthesize SD disks or announce a ready service here.
  # No authenticated mount provider has been admitted on this profile.
  # Advertising "registered" here would be a false device/service state.
  ret -1
}
