# library/ui/img.nx — Image Rendering Service
# Centralised rendering for .nxtimg (ANSI) assets.

fn ui_draw_image(path x y) {
  if x != -1 {
    if y != -1 {
      term_at(y x "")
    }
  }

  n_shards = reg_get("/sys/vfs/files/" + path + "@@n")
  if type(n_shards) != "err" {
    cnt = int(n_shards)
    j = 0
    loop {
      if j >= cnt { break }
      shard = reg_get("/sys/vfs/files/" + path + "@@" + str(j))
      if type(shard) != "err" {
        write(1 shard)
      }
      j = j + 1
    }
  } else {
    data = reg_get("/sys/vfs/files/" + path)
    if type(data) == "err" {
      data = vfs_read(path)
    }
    if type(data) != "err" {
      write(1 data)
    }
  }

  write(1 "\033[0m")
  ret 0
}

fn ui_draw_logo(name x y) {
  ret ui_draw_image("/user/logos/" + name + ".nxtimg" x y)
}

kout("[ui] Image rendering service loaded.")
