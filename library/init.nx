reg /sys/init/status = "booting"
reg /sys/init/pid    = 1

exec("modules/stdlib.nx")

kout("[init] NEXS PID 1 starting...")

exec("library/auth/init.nx")
exec("library/fs/init.nx")
exec("library/pm/pm.nx")
exec("library/tty/init.nx")
exec("library/ui/init.nx")

reg /sys/init/status = "running"
kout("[init] All services running.")

loop {
  msg = receivemessage /proc/1/inbox
  if msg == "shutdown" {
    kout("[init] Shutdown received.")
    reg /sys/init/status = "shutdown"
    exits "shutdown"
  }
  if msg == "reboot" {
    kout("[init] Reboot received.")
    reg /sys/init/status = "reboot"
    exits "reboot"
  }
}
