# ===================================================================
# MiniOS Userspace Standard Library (stdlib.nx)
# ===================================================================

fn input(prompt) {
  write(1 prompt)
  rawon()
  buffer = ""
  loop {
    ch = readkey()
    if ch == "" { continue }
    
    if ch == "CTRL_X" {
      break
    }
    
    if ch == "ENTER" {
      write(1 "\n")
      break
    }

    if ch == "BACKSPACE" {
      blen = len(buffer)
      if blen > 0 {
        write(1 "\b \b")
        buffer = substr(buffer 0 blen - 1)
      }
    } else {
      # Per evitare che le frecce stampino codice nello schermo
      if len(ch) == 1 {
        write(1 ch)
        buffer = buffer + ch
      }
    }
  }
  rawoff()
  ret buffer
}

fn cat(path) {
  ret vfs_read(path)
}

fn cp(src dst) {
  content = vfs_read(src)
  vfs_write(dst content)
  ret 0
}

fn mv(src dst) {
  cp(src dst)
  vfs_rm(src)
  ret 0
}

fn rm(path) {
  vfs_rm(path)
  ret 0
}

fn exists(path) {
  val = vfs_read(path)
  if type(val) == "err" {
    ret 0
  }
  ret 1
}
