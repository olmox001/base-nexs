# ===================================================================
# Modulo Shell (Userspace CLI) v2
# Aggiunto: error handler, source, errlog, modules, rm, cp, mv
# ===================================================================

fn shell_help() {
  out "  Comandi standard:"
  out "  ls [dir]      - Mostra i file nel VFS"
  out "  cat file      - Legge un file dal VFS"
  out "  rm file       - Rimuove un file dal VFS"
  out "  cp src dst    - Copia un file"
  out "  mv src dst    - Sposta un file"
  out "  ps            - Mostra i processi allocati"
  out "  devtree       - Mostra il Device Tree hardware"
  out "  fm [dir]      - Avvia il Plan 9 File Manager"
  out "  modules       - Elenca moduli .nx caricati nel VFS"
  out "  source file   - Esegue un file .nx dal VFS"
  out "  errlog        - Mostra l'ultimo errore registrato"
  out "  runvm         - Esegue il bytecode Wasm di test"
  out "  nxed          - Editor di testo (VFS/Host)"
  out "  exit          - Spegne il sistema"
  out ""
  out "  Funzioni NEXS (valutate direttamente):"
  out "  reg_get(path) reg_set(path val) keys(path)"
  out "  sendmessage(q msg) receivemessage(q) msgpending(q)"
}

fn shell_loop() {
  out "---------------------------------------------------"
  out " NEXS Shell v2.0. Digita 'help' per i comandi."
  out "---------------------------------------------------"

  loop {
    write(1 "\033[s\033[24;1H\033[1;37;44m NEXS OS v0.2.0 | PID 101: Shell | VFS: / | Reg: OK \033[0K\033[u")
    cmd_full = input("nexs-os> \033[5m_\033[0m\b")
    parts = split(cmd_full " ")
    parts_len = len(parts)
    if parts_len == 0 { continue }

    cmd = parts[0]
    arg = ""
    if parts_len > 1 { arg = parts[1] }
    arg2 = ""
    if parts_len > 2 { arg2 = parts[2] }

    if cmd == "exit" {
      out "Esecuzione sequenza di spegnimento..."
      break
    }

    handled = 0

    if cmd == "help"    { shell_help()
                          handled = 1 }
    if cmd == "ls"      { vfs_ls(arg)
                          handled = 1 }
    if cmd == "ps"      { pm_ps()
                          handled = 1 }
    if cmd == "devtree" { hw_dt_dump()
                          handled = 1 }
    if cmd == "fm"      { p9_file_manager(arg)
                          handled = 1 }

    if cmd == "cat" {
      if arg == "" {
        out "Uso: cat <file>"
      } else {
        out vfs_read(arg)
      }
      handled = 1
    }

    if cmd == "rm" {
      if arg == "" {
        out "Uso: rm <file>"
      } else {
        vfs_rm(arg)
      }
      handled = 1
    }

    if cmd == "cp" {
      if arg == "" {
        out "Uso: cp <src> <dst>"
      } else {
        cp(arg arg2)
      }
      handled = 1
    }

    if cmd == "mv" {
      if arg == "" {
        out "Uso: mv <src> <dst>"
      } else {
        mv(arg arg2)
      }
      handled = 1
    }

    if cmd == "modules" {
      vfs_ls("sys/modules")
      handled = 1
    }

    if cmd == "source" {
      if arg == "" {
        out "Uso: source <vfs_path>"
      } else {
        src = vfs_read(arg)
        if type(src) == "err" {
          out "[ERR] File non trovato: " + arg
        } else {
          result = eval(src)
          if type(result) == "err" { out "[ERR] " + str(result) }
        }
      }
      handled = 1
    }

    if cmd == "errlog" {
      last = reg_get("/sys/errors/last")
      if type(last) == "err" { last = "(nessun errore)" }
      if last == "" { last = "(nessun errore)" }
      out "Ultimo errore: " + last
      handled = 1
    }

    if cmd == "runvm" {
      bytecode[0] = 0
      bytecode[1] = 10
      bytecode[2] = 0
      bytecode[3] = 20
      bytecode[4] = 1
      bytecode[5] = 0
      bytecode[6] = 2
      bytecode[7] = 2
      bytecode[8] = 3
      bytecode[9] = 4
      vm_run(bytecode 10)
      handled = 1
    }

    if cmd == "nxed" {
      nxed_start()
      handled = 1
    }

    # Fallback: Valuta come codice NEXS puro con error handler
    if handled == 0 {
      result = eval(cmd_full)
      if type(result) == "err" {
        errmsg = str(result)
        out "[ERR] " + errmsg
        reg_set("/sys/errors/last" errmsg)
      }
    }
  }
}