# ===================================================================
# NXED v14 — Array Buffer + Full Line Editing
# Split/merge righe, HOME/END/PGUP/PGDN, non-blocking input
# ===================================================================
# ===================================================================

MAX_Y = 0
SCR_H = 20
SCR_W = 80
cur_x = 0
cur_y = 0
view_y = 0
buf[0] = ""
status_msg = ""

fn get_ln(y) {
  if y > MAX_Y { ret "" }
  v = buf[y]
  if type(v) == "err" { ret "" }
  if type(v) == "nil" { ret "" }
  ret str(v)
}

fn set_ln(y v) {
  buf[y] = v
}

fn nxed_render_line(i) {
  ESC = chr(27)
  txt = get_ln(i)
  row = i - view_y + 2
  if row < 2 { ret }
  if row > (SCR_H + 1) { ret }

  if i == cur_y {
    term_at(row 1 "> " + txt + ESC + "[K")
  } else {
    term_at(row 1 "  " + txt + ESC + "[K")
  }
}

fn input_raw_line() {
  buffer = ""
  loop {
    fc = readkey()
    if fc == "ENTER" { break }
    if fc == "BACKSPACE" {
      blen = len(buffer)
      if blen > 0 {
        write(1 chr(27) + "[1D " + chr(27) + "[1D")
        buffer = substr(buffer 0 blen - 1)
      }
    } else {
      if len(fc) == 1 {
        write(1 fc)
        buffer = buffer + fc
      }
    }
  }
  ret buffer
}

fn nxed_buf_to_str() {
  ret arr_join(buf "\n")
}

fn nxed_load_str(content) {
  lines = split(content "\n")
  nlines = len(lines)
  if nlines <= 0 {
    buf[0] = ""
    MAX_Y = 0
    ret 0
  }
  i = 0
  loop {
    if i >= nlines { break }
    buf[i] = lines[i]
    i = i + 1
  }
  MAX_Y = nlines - 1
  ret 0
}

fn nxed_save_vfs() {
  ESC = chr(27)
  write(1 "\nNome file VFS: " + ESC + "[?25h")
  fname = input_raw_line()
  write(1 ESC + "[?25l")
  if len(fname) > 0 {
    vfs_write(fname nxed_buf_to_str())
    status_msg = "Salvato VFS: " + fname
  }
}

fn nxed_export_host() {
  ESC = chr(27)
  write(1 "\nEsporta Host: " + ESC + "[?25h")
  fname = input_raw_line()
  write(1 ESC + "[?25l")
  if len(fname) > 0 {
    fd = create(fname 1 0644)
    if fd >= 0 {
      write(fd nxed_buf_to_str())
      close(fd)
      status_msg = "Esportato: " + fname
    } else {
      status_msg = "ERR: impossibile creare " + fname
    }
  }
}

fn nxed_import_host() {
  ESC = chr(27)
  write(1 "\nImporta Host: " + ESC + "[?25h")
  fname = input_raw_line()
  write(1 ESC + "[?25l")
  if len(fname) > 0 {
    fd = open(fname 0)
    if fd >= 0 {
      content = read(fd 65536)
      close(fd)
      nxed_load_str(content)
      cur_x = 0
      cur_y = 0
      view_y = 0
      status_msg = "Importato: " + fname
    } else {
      status_msg = "ERR: file non trovato"
    }
  }
}

fn nxed_set_layout() {
  ESC = chr(27)
  write(1 "\nLayout (us/uk/uk-mac/ita/ita-mac): " + ESC + "[?25h")
  lname = input_raw_line()
  write(1 ESC + "[?25l")
  if len(lname) > 0 {
    set_layout(lname)
    status_msg = "Layout: " + lname
  }
}

fn nxed_start() {
  rawon()
  O = 1

  ESC = chr(27)

  # Buffer come array nativo — nessuna lookup registry per riga
  buf[0] = ""
  ts = term_size()
  SCR_W = ts[0]
  SCR_H = ts[1] - 4
  
  MAX_Y = 0
  status_msg = ""

  term_cls()
  term_cursor_show(1)

  last_y = -1
  last_x = -1
  last_view_y = -1
  last_max_y = -1
  last_status = ""

  loop {
    # --- RENDERER OTTIMIZZATO ---
    dirty = 0
    if view_y != last_view_y { dirty = 1 }
    if MAX_Y != last_max_y { dirty = 1 }
    
    # Status bar
    new_status = " L:" + str(cur_y + 1) + "/" + str(MAX_Y + 1) + " C:" + str(cur_x)
    if new_status != last_status || status_msg != "" {
      hdr = ESC + "[7m NXED v16 |" + new_status + " | ^X:Menu " + ESC + "[0m"
      if status_msg != "" {
        hdr = hdr + " " + ESC + "[33m" + status_msg + ESC + "[0m"
      }
      term_at(1 1 hdr)
      last_status = new_status
    }

    if dirty == 1 {
      # Redraw corpo intero
      i = view_y
      limit = view_y + SCR_H
      loop {
        if i >= limit { break }
        nxed_render_line(i)
        i = i + 1
      }
      last_view_y = view_y
      last_max_y = MAX_Y
      last_y = cur_y
      last_x = cur_x
    } else {
      # Solo aggiornamento riga corrente se cambiata
      if cur_y != last_y {
        nxed_render_line(last_y)
        nxed_render_line(cur_y)
        last_y = cur_y
        last_x = cur_x
      } else {
        if cur_x != last_x {
          nxed_render_line(cur_y)
          last_x = cur_x
        }
      }
    }

    status_msg = ""

    # --- INPUT non-bloccante (50ms timeout) ---
    ch = readkey_nb(50)
    if ch == "" {
      sleep(10)
      cont
    }

    # ─── 0. MENU (CTRL_X) ──────────────────────────────────────────
    if ch == "CTRL_X" {
      write(O ESC + "[2J" + ESC + "[H")
      write(O ESC + "[7m --- MENU DI SISTEMA NEXS --- " + ESC + "[0m\n")
      write(O " q : Esci senza salvare\n")
      write(O " s : Salva nel VFS locale\n")
      write(O " e : Esporta su disco Host\n")
      write(O " i : Importa da disco Host\n")
      write(O " k : Cambia Layout Tastiera\n")
      write(O " c : Annulla e continua\n\n> ")
      opt_k = readkey()
      if opt_k == "q" {
        write(O ESC + "[?25h" + ESC + "[2J" + ESC + "[H")
        rawoff()
        break
      }
      if opt_k == "s" { nxed_save_vfs() }
      if opt_k == "e" { nxed_export_host() }
      if opt_k == "i" { nxed_import_host() }
      if opt_k == "k" { nxed_set_layout() }
      cont
    }

    # ─── 1. NAVIGAZIONE ────────────────────────────────────────────
    if ch == "KEY_UP" || ch == "UP" {
      if cur_y > 0 { cur_y = cur_y - 1 }
      if cur_y < view_y { view_y = cur_y }
      ll = len(get_ln(cur_y))
      if cur_x > ll { cur_x = ll }
      cont
    }
    if ch == "KEY_DOWN" || ch == "DOWN" {
      if cur_y < MAX_Y { cur_y = cur_y + 1 }
      if cur_y >= (view_y + SCR_H) { view_y = view_y + 1 }
      ll = len(get_ln(cur_y))
      if cur_x > ll { cur_x = ll }
      cont
    }
    if ch == "KEY_RIGHT" || ch == "RIGHT" {
      ll = len(get_ln(cur_y))
      if cur_x < ll {
        cur_x = cur_x + 1
      } else {
        # Vai all'inizio della riga successiva
        if cur_y < MAX_Y {
          cur_y = cur_y + 1
          cur_x = 0
          if cur_y >= (view_y + SCR_H) { view_y = view_y + 1 }
        }
      }
      cont
    }
    if ch == "KEY_LEFT" || ch == "LEFT" {
      if cur_x > 0 {
        cur_x = cur_x - 1
      } else {
        # Vai alla fine della riga precedente
        if cur_y > 0 {
          cur_y = cur_y - 1
          if cur_y < view_y { view_y = cur_y }
          cur_x = len(get_ln(cur_y))
        }
      }
      cont
    }
    if ch == "KEY_HOME" {
      cur_x = 0
      cont
    }
    if ch == "KEY_END" {
      cur_x = len(get_ln(cur_y))
      cont
    }
    if ch == "KEY_PGUP" {
      cur_y = cur_y - SCR_H
      if cur_y < 0 { cur_y = 0 }
      view_y = cur_y
      cont
    }
    if ch == "KEY_PGDN" {
      cur_y = cur_y + SCR_H
      if cur_y > MAX_Y { cur_y = MAX_Y }
      view_y = cur_y - SCR_H + 1
      if view_y < 0 { view_y = 0 }
      cont
    }
    # ─── 2. CANCELLAZIONE ──────────────────────────────────────────
    if ch == "BACKSPACE" {
      if cur_x > 0 {
        # Cancella carattere a sinistra del cursore
        txt = get_ln(cur_y)
        l = len(txt)
        p1 = substr(txt 0 cur_x - 1)
        p2 = ""
        rem = l - cur_x
        if rem > 0 { p2 = substr(txt cur_x rem) }
        set_ln(cur_y p1 + p2)
        cur_x = cur_x - 1
      } else {
        # Inizio riga: merge con riga precedente
        if cur_y > 0 {
          prev = get_ln(cur_y - 1)
          curr = get_ln(cur_y)
          new_x = len(prev)
          set_ln(cur_y - 1 prev + curr)
          arr_del(buf cur_y)
          if MAX_Y > 0 { MAX_Y = MAX_Y - 1 }
          cur_y = cur_y - 1
          cur_x = new_x
          if cur_y < view_y { view_y = cur_y }
        }
      }
      cont
    }

    if ch == "KEY_DELETE" {
      txt = get_ln(cur_y)
      l = len(txt)
      if cur_x < l {
        # DELETE — cancella carattere sotto cursore
        p1 = substr(txt 0 cur_x)
        p2 = ""
        rem = l - cur_x - 1
        if rem > 0 { p2 = substr(txt cur_x + 1 rem) }
        set_ln(cur_y p1 + p2)
      } else {
        # Fine riga: merge con riga successiva
        if cur_y < MAX_Y {
          next = get_ln(cur_y + 1)
          set_ln(cur_y txt + next)
          arr_del(buf cur_y + 1)
          MAX_Y = MAX_Y - 1
        }
      }
      cont
    }

    # ─── 3. INVIO — split riga ─────────────────────────────────────
    if ch == "ENTER" {
      txt = get_ln(cur_y)
      l = len(txt)
      p1 = substr(txt 0 cur_x)
      p2 = ""
      if cur_x < l { p2 = substr(txt cur_x l - cur_x) }
      set_ln(cur_y p1)
      arr_ins(buf cur_y + 1 p2)
      MAX_Y = MAX_Y + 1
      cur_y = cur_y + 1
      cur_x = 0
      if cur_y >= (view_y + SCR_H) { view_y = view_y + 1 }
      cont
    }

    # ─── 4. TAB — inserisce 2 spazi ────────────────────────────────
    if ch == "TAB" {
      txt = get_ln(cur_y)
      l = len(txt)
      if cur_x >= l {
        set_ln(cur_y txt + "  ")
      } else {
        p1 = substr(txt 0 cur_x)
        p2 = substr(txt cur_x l - cur_x)
        set_ln(cur_y p1 + "  " + p2)
      }
      cur_x = cur_x + 2
      cont
    }

    # ─── 5. SCRITTURA CARATTERI NORMALI — insert in posizione ──────
    if len(ch) == 1 {
      txt = get_ln(cur_y)
      l = len(txt)
      if cur_x >= l {
        set_ln(cur_y txt + ch)
      } else {
        p1 = substr(txt 0 cur_x)
        p2 = substr(txt cur_x l - cur_x)
        set_ln(cur_y p1 + ch + p2)
      }
      cur_x = cur_x + 1
    }

    # Posiziona il cursore hardware alla fine del rendering
    term_cursor_move(cur_y - view_y + 2, cur_x + 3)
  }
}
