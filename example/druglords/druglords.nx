ui_draw_image("example/druglords/druglords.nxtimg" -1 -1)
hr()
out C_B_WHT + " DRUG LORDS — NEXS Edition" + C_RST
hr()
nl()
out " Your goal: Build a drug empire. No time limits."
out " Start : " + C_GRN + "$2,000 cash" + C_RST + " | " + C_RED + "$5,500 debt @ 10% interest/day" + C_RST
out " Pockets: " + str(MAX_POCKETS) + " units total"
nl()
out " Travel costs " + C_RED + "$" + str(TRAVEL_COST) + C_RST + " but generates new market prices."
out " Use the " + C_BLU + "Bank" + C_RST + " to protect your cash from muggers."
out " Pay off your debt before the loan shark bleeds you dry."
nl()
out " Press ENTER to start or 'q' to quit..."
ans = input("")
if ans == "q" || ans == "quit" {
  exits("")
} else {
  nl()
}

init_game()
game_loop()

out " Press ENTER to exit the game."
input("")
exits("")