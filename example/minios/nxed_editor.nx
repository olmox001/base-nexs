# ===================================================================
# NXED v18 — Professional Text Editor for NEXS
# Using services/textbuf.nx for data integrity
# ===================================================================

# Variabili Globali
cur_x = 0
cur_y = 0
view_y = 0
SCR_H = 20
SCR_W = 80
filename = ""
status_msg = ""
ed_buf = 0 # Pointer al buffer di textbuf
ESC = "\e"

fn nxed_render_line(y) {
  txt = tb_get_line(ed_buf y)
  row = y - view_y + 2
  if row < 2 || row > (SCR_H + 1) { ret }

  # Tronca se troppo lunga per lo schermo
  display_txt = txt
  if len(txt) > (SCR_W - 5) {
    display_txt = substr(txt 0 SCR_W - 5)
  }

  prefix = "  "
  if y == cur_y { prefix = "> " }
  
  term_at(row 1 prefix + display_txt + ESC + "[K")
}

fn nxed_full_render() {
  i = view_y
  limit = view_y + SCR_H
  loop {
    if i >= limit { break }
    nxed_render_line(i)
    i = i + 1
  }
}

fn nxed_input_line(prompt) {
  write(1 "\n" + prompt + ": " + ESC + "[?25h")
  res = ""
  loop {
    ch = readkey()
    if ch == "ENTER" { break }
    if ch == "BACKSPACE" {
      if len(res) > 0 {
        write(1 "\b \b")
        res = substr(res 0 len(res) - 1)
      }
    } else {
      if len(ch) == 1 {
        write(1 ch)
        res = res + ch
      }
    }
  }
  write(1 ESC + "[?25l")
  ret res
}

fn nxed_start(initial_file) {
  rawon()
  term_cls()
  
  exec("services/textbuf.nx")
  ed_buf = tb_create()
  filename = ""
  if initial_file != "" {
    filename = initial_file
    content = vfs_read(filename)
    if type(content) != "err" {
      tb_load(ed_buf content)
      status_msg = "Caricato: " + filename
    } else {
      status_msg = "Nuovo file: " + filename
    }
  }
  
  # Parametri schermo
  ts = term_size()
  SCR_W = ts[0]
  SCR_H = ts[1] - 4
  
  term_cursor_show(0)
  
  last_y = -1
  last_view_y = -1
  last_status = ""

  loop {
    # --- RENDER ---
    max_y = len(ed_buf) - 1
    
    # Status Bar
    stat = " L:" + str(cur_y + 1) + "/" + str(max_y + 1) + " C:" + str(cur_x)
    if filename != "" { stat = " [" + filename + "]" + stat }
    if stat != last_status || status_msg != "" {
      hdr = ESC + "[7m NXED v18 |" + stat + " | ^X:Menu " + ESC + "[0m"
      if status_msg != "" { hdr = hdr + " " + ESC + "[33m" + status_msg + ESC + "[0m" }
      term_at(1 1 hdr)
      last_status = stat
      status_msg = ""
    }

    # Scrolling
    if cur_y < view_y {
      view_y = cur_y
      last_view_y = -1
    }
    if cur_y >= (view_y + SCR_H) {
      view_y = cur_y - SCR_H + 1
      last_view_y = -1
    }

    if view_y != last_view_y {
      nxed_full_render()
      last_view_y = view_y
      last_y = cur_y
    } else {
      if cur_y != last_y {
        # Ridisegna solo le righe che sono cambiate
        if last_y >= 0 { nxed_render_line(last_y) }
        nxed_render_line(cur_y)
        last_y = cur_y
      }
    }

    # Posiziona cursore
    term_cursor_move(cur_y - view_y + 2, cur_x + 3)
    term_cursor_show(1)
    term_flush()

    # --- INPUT ---
    k = readkey()
    if k == "" { continue }
    
    # --- LOGICA TASTI ---
    processed = 0

    if k == "CTRL_X" {
      term_cursor_show(1)
      term_at(1 1 ESC + "[7m MENU: [q]Esci [s]Salva [e]Esporta [i]Importa [l]Layout [c]Annulla " + ESC + "[0m" + ESC + "[K")
      term_flush()
      opt = readkey()
      
      if opt == "q" {
        term_cls()
        rawoff()
        break
      }
      if opt == "s" {
        if filename == "" { filename = nxed_input_line("Nome file VFS") }
        if filename != "" {
          vfs_write(filename tb_to_str(ed_buf))
          status_msg = "Salvato VFS"
        }
      }
      if opt == "e" {
        fname = nxed_input_line("Nome file HOST")
        if fname != "" {
          fd = create(fname 1 0644)
          if fd >= 0 {
            write(fd tb_to_str(ed_buf))
            close(fd)
            status_msg = "Esportato Host"
          } else {
            status_msg = "ERRORE Host"
          }
        }
      }
      if opt == "i" {
        fname = nxed_input_line("Importa HOST")
        if fname != "" {
          fd = open(fname 0)
          if fd >= 0 {
            content = read(fd 65536)
            close(fd)
            tb_load(ed_buf content)
            cur_x = 0
            cur_y = 0
            view_y = 0
            last_view_y = -1
            filename = fname
            status_msg = "Importato"
          } else {
            status_msg = "Non trovato"
          }
        }
      }
      if opt == "l" {
        lay = nxed_input_line("Layout (us/ita/...)")
        if lay != "" {
          set_layout(lay)
          status_msg = "Layout: " + lay
        }
      }
      
      last_view_y = -1 # Forza redraw
      processed = 1
    }

    if processed == 0 {
      # Movimento
      if k == "UP" || k == "KEY_UP" {
        if cur_y > 0 { cur_y = cur_y - 1 }
        processed = 1
      } else if k == "DOWN" || k == "KEY_DOWN" {
        if cur_y < max_y { cur_y = cur_y + 1 }
        processed = 1
      } else if k == "LEFT" || k == "KEY_LEFT" {
        if cur_x > 0 { 
          cur_x = cur_x - 1 
        } else if cur_y > 0 {
          cur_y = cur_y - 1
          cur_x = len(tb_get_line(ed_buf cur_y))
        }
        processed = 1
      } else if k == "RIGHT" || k == "KEY_RIGHT" {
        ll = len(tb_get_line(ed_buf cur_y))
        if cur_x < ll { 
          cur_x = cur_x + 1 
        } else if cur_y < max_y {
          cur_y = cur_y + 1
          cur_x = 0
        }
        processed = 1
      } else if k == "KEY_HOME" || k == "HOME" {
        cur_x = 0
        processed = 1
      } else if k == "KEY_END" || k == "END" {
        cur_x = len(tb_get_line(ed_buf cur_y))
        processed = 1
      } else if k == "ENTER" {
        tb_split_line(ed_buf cur_y cur_x)
        cur_y = cur_y + 1
        cur_x = 0
        last_view_y = -1 # Forza redraw
        processed = 1
      } else if k == "BACKSPACE" {
        if cur_x > 0 {
          tb_delete_char(ed_buf cur_y cur_x)
          cur_x = cur_x - 1
          nxed_render_line(cur_y)
        } else if cur_y > 0 {
          new_x = tb_merge_line(ed_buf cur_y)
          cur_y = cur_y - 1
          cur_x = new_x
          last_view_y = -1
        }
        processed = 1
      } else if k == "KEY_DELETE" {
        txt = tb_get_line(ed_buf cur_y)
        if cur_x < len(txt) {
          tb_delete_char(ed_buf cur_y cur_x + 1)
          nxed_render_line(cur_y)
        } else if cur_y < max_y {
          tb_merge_line(ed_buf cur_y + 1)
          last_view_y = -1
        }
        processed = 1
      } else if len(k) == 1 {
        tb_insert_char(ed_buf cur_y cur_x k)
        cur_x = cur_x + 1
        nxed_render_line(cur_y)
        processed = 1
      }
    }
    
    # Se il cursore è oltre la fine della riga, riportalo indietro
    line_txt = tb_get_line(ed_buf cur_y)
    ll = len(line_txt)
    if cur_x > ll { cur_x = ll }
  }
}
