# ===================================================================
# NXED v4.0 — MODULAR MICROKERNEL TEXT EDITOR
# ===================================================================

# --- Costanti e Variabili Globali ---
G_ESC = "\e"
ed_running = 1
ed_mode = 0       # 0 = Edit, 1 = Menu
ed_status = "Pronto. Premi CTRL-X per il menu."
ed_filename = ""
cx = 0
cy = 0
scroll_y = 0
term_w = 80
term_h = 24
ed_buf = tb_create()

# --- Helpers ---
fn ed_clamp_cursor() {
    max_y = len(ed_buf) - 1
    if max_y < 0 { max_y = 0 }
    if cy > max_y { cy = max_y }
    if cy < 0 { cy = 0 }
    curr_line = tb_get_line(ed_buf cy)
    max_x = len(curr_line)
    if cx > max_x { cx = max_x }
    if cx < 0 { cx = 0 }
    if cy < scroll_y { scroll_y = cy }
    if cy >= scroll_y + (term_h - 1) { scroll_y = cy - (term_h - 2) }
}

fn ed_render_text() {
    term_cls()
    num_lines = len(ed_buf)
    i = 0
    loop {
        if i >= (term_h - 1) { break }
        buf_idx = scroll_y + i
        if buf_idx < num_lines {
            line_str = tb_get_line(ed_buf buf_idx)
            if len(line_str) > term_w { line_str = substr(line_str 0 term_w) }
            term_at(i + 1 1 line_str)
        } else { term_at(i + 1 1 "~") }
        i = i + 1
    }
    stat = G_ESC + "[7m NXED | File: " + ed_filename + " | L:" + str(cy+1) + " C:" + str(cx+1) + " | " + ed_status + " " + G_ESC + "[0m"
    if len(stat) > term_w { stat = substr(stat 0 term_w) }
    term_at(term_h 1 stat)
    screen_y = (cy - scroll_y) + 1
    screen_x = cx + 1
    term_cursor_move(screen_y screen_x)
    term_flush()
}

fn ed_prompt(prompt_testo valore_default) {
    term_at(term_h 1 G_ESC + "[K")
    res = input(G_ESC + "[7m " + prompt_testo + ": " + G_ESC + "[0m " valore_default)
    rawon() 
    ret res
}

fn ed_render_menu() {
    term_cls()
    term_at(1 1 G_ESC + "[7m NEXS SYSTEM MENU | NXED v4.0 " + G_ESC + "[0m")
    term_at(4  5 "[CTRL-X] RITORNA    - Torna all'editor")
    term_at(6  5 "[s]      SALVA VFS  - Salva nel Virtual File System")
    term_at(8  5 "[o]      APRI VFS   - Carica un file dal VFS")
    term_at(10 5 "[v]      VISUALIZZA - Visualizza immagine (.nxtimg)")
    term_at(12 5 "[e]      ESPORTA    - Esporta file verso l'host")
    term_at(14 5 "[i]      IMPORTA    - Importa file dall'host")
    term_at(16 5 "[q]      ESCI       - Chiudi senza salvare")
    if ed_status != "" { term_at(18 5 G_ESC + "[33mSTATO: " + ed_status + G_ESC + "[0m") }
    term_at(22 1 "Premi un tasto per selezionare...")
    term_flush()
}

fn ed_handle_edit_key(k) {
    ed_status = ""
    if k == "\x18" || k == "CTRL-X" || k == "CTRL_X" || k == "ESC" || k == "\e" || k == "\x1b" {
        ed_mode = 1
        ret 0
    }
    if k == "UP" || k == "KEY_UP" { 
        cy = cy - 1
        ed_clamp_cursor()
        ret 0 
    }
    if k == "DOWN" || k == "KEY_DOWN" { 
        cy = cy + 1
        ed_clamp_cursor()
        ret 0 
    }
    if k == "LEFT" || k == "KEY_LEFT" {
        cx = cx - 1
        if cx < 0 { 
            if cy > 0 { 
                cy = cy - 1
                cx = len(tb_get_line(ed_buf cy)) 
            } else { 
                cx = 0 
            } 
        }
        ed_clamp_cursor()
        ret 0
    }
    if k == "RIGHT" || k == "KEY_RIGHT" {
        cx = cx + 1
        max_x = len(tb_get_line(ed_buf cy))
        if cx > max_x { 
            if cy < len(ed_buf) - 1 { 
                cy = cy + 1
                cx = 0 
            } else { 
                cx = max_x 
            } 
        }
        ed_clamp_cursor()
        ret 0
    }
    if k == "ENTER" { 
        tb_split_line(ed_buf cy cx)
        cy = cy + 1
        cx = 0
        ed_clamp_cursor()
        ret 0 
    }
    if k == "BACKSPACE" {
        if cx > 0 { 
            tb_delete_char(ed_buf cy cx)
            cx = cx - 1 
        } else { 
            if cy > 0 { 
                prev_len = len(tb_get_line(ed_buf cy - 1))
                tb_merge_line(ed_buf cy)
                cy = cy - 1
                cx = prev_len 
            } 
        }
        ed_clamp_cursor()
        ret 0
    }
    if len(k) == 1 && k != "\x18" { 
        tb_insert_char(ed_buf cy cx k)
        cx = cx + 1
        ed_clamp_cursor() 
    }
}

fn ed_handle_menu_key(k) {
    # ESC, CTRL-X o \e per tornare all'editor
    if k == "\x18" || k == "CTRL-X" || k == "CTRL_X" || k == "ESC" || k == "\e" || k == "\x1b" { 
        ed_mode = 0
        ed_status = "Editor attivo."
        ret 0 
    }
    if k == "q" { 
        ed_running = 0
        ed_mode = 0
        ret 0 
    }
    if k == "s" {
        def_name = ed_filename
        if def_name == "" {
            def_name = getcwd()
            if substr(def_name len(def_name)-1 1) != "/" { def_name = def_name + "/" }
        }
        nuovo_nome = ed_prompt("Salva come" def_name)
        if type(nuovo_nome) == "str" && nuovo_nome != "" {
            res_nome = vfs_resolve(nuovo_nome getcwd())
            ed_filename = res_nome
            vfs_write(ed_filename tb_to_str(ed_buf))
            ed_status = "Salvato: " + ed_filename
        }
        ed_mode = 0
        ret 0
    }
    if k == "o" {
        fname = ed_prompt("Apri file (VFS)" "")
        if type(fname) == "str" && fname != "" {
            res_fname = vfs_resolve(fname getcwd())
            lettura = vfs_read(res_fname)
            if type(lettura) != "err" && substr(lettura 0 4) != "ERR:" {
                tb_load(ed_buf lettura)
                ed_filename = res_fname
                cy = 0
                cx = 0
                scroll_y = 0
                ed_status = "Caricato: " + res_fname
            } else { 
                ed_status = "Errore: file non trovato (" + res_fname + ")" 
            }
        }
        ed_mode = 0
        ret 0
    }
    if k == "v" {
        img_path = ed_prompt("Visualizza immagine (.nxtimg)" "")
        if type(img_path) == "str" && img_path != "" {
          pm_spawn(get_proc_uid() "/Applications/termimg.nx" img_path)
          ed_status = "Visualizzatore avviato."
        }
        ed_mode = 0
        ret 0
    }
    if k == "e" {
        hpath = ed_prompt("Host Path Export" "")
        if type(hpath) == "str" && hpath != "" {
            vfs_write("/tmp/nxed_export" tb_to_str(ed_buf))
            vfs_export("/tmp/nxed_export" hpath)
            ed_status = "Esportato su Host: " + hpath
        }
        ed_mode = 0
        ret 0
    }
    if k == "i" {
        hpath = ed_prompt("Host Path Import" "")
        if type(hpath) == "str" && hpath != "" {
            vfs_import(hpath "/tmp/nxed_import")
            tb_load(ed_buf vfs_read("/tmp/nxed_import"))
            ed_status = "Importato con successo."
        }
        ed_mode = 0
        ret 0
    }
}

fn nxed_start(initial_file) {
    ts = term_size()
    if len(ts) >= 2 { 
        term_w = int(ts[0])
        term_h = int(ts[1]) 
    }
    rawon()
    term_cursor_show(1)
    if initial_file != "" { ed_filename = vfs_resolve(initial_file getcwd()) }
    else { ed_filename = "" }
    ed_buf = tb_create()
    if ed_filename != "" {
        lettura = vfs_read(ed_filename)
        if type(lettura) != "err" && substr(lettura 0 4) != "ERR:" {
            tb_load(ed_buf lettura)
            ed_status = "File caricato."
        } else { ed_status = "Nuovo file." }
    }
    loop {
        if ed_running == 0 { break }
        if ed_mode == 0 {
            ed_render_text()
            k = readkey()
            ed_handle_edit_key(k)
        } else {
            term_cursor_show(0)
            ed_render_menu()
            k = readkey()
            ed_handle_menu_key(k)
            term_cursor_show(1)
        }
    }
    term_cls()
    term_cursor_show(1)
    rawoff()
    term_flush()
}
fn _entry() {
  arg = ""
  if type(PROC_BASE) == "str" {
    reg_set(PROC_BASE + "/fullscreen" 1)
    arg = reg_get(PROC_BASE + "/args")
    if type(arg) != "str" { arg = "" }
  }
  nxed_start(arg)
}
_entry()
