# ===================================================================
# REGFS - Registry File System Serialization
# Serializza un ramo del registro su file VFS e lo ricarica.
# ===================================================================

fn _regfs_dump_node(current_path fd) {
  v = reg_get(current_path)
  t = type(v)
  if t != "err" && t != "nil" && t != "arr" && t != "ptr" && t != "fn" {
    line = t + "|" + current_path + "|" + str(v) + "\n"
    write(fd line)
  }
  children = keys(current_path)
  len_c = len(children)
  i = 0
  loop {
    if i >= len_c { break }
    child_name = children[i]
    if current_path == "/" {
      child_path = "/" + str(child_name)
    } else {
      child_path = str(current_path) + "/" + str(child_name)
    }
    _regfs_dump_node(child_path fd)
    i = i + 1
  }
}

fn regfs_save(path_in_reg file_path) {
  fd = open(file_path 1)
  if fd < 0 {
    ret -1
  }
  _regfs_dump_node(path_in_reg fd)
  close(fd)
  ret 0
}

fn regfs_load(file_path) {
  fd = open(file_path 0)
  if fd < 0 {
    ret -1
  }
  
  content = read(fd 65536)
  close(fd)
  
  lines = split(content "\n")
  count = len(lines)
  i = 0
  loop {
    if i >= count { break }
    line = lines[i]
    if len(line) > 0 {
      parts = split(line "|")
      if len(parts) >= 3 {
        vtype = parts[0]
        vpath = parts[1]
        vval_str = parts[2]
        
        # Ripristina il valore con il tipo corretto
        if vtype == "int" {
           reg_set(vpath int(vval_str))
        } 
        if vtype == "str" {
           reg_set(vpath vval_str)
        }
        if vtype == "float" {
           reg_set(vpath float(vval_str))
        }
        if vtype == "bool" {
           if vval_str == "true" {
             reg_set(vpath true)
           } else {
             reg_set(vpath false)
           }
        }
      }
    }
    i = i + 1
  }
  
  ret 0
}
