# example/minios/init_logos.nx — Loghi .nxtimg nel VFS (layout a nodi interlacciati)
# =============================================================================
# Ogni riga ANSI e un nodo: vfs_base + "@@i", conteggio in vfs_base + "@@n".
# Ingestione a finestre: read piccoli + sbucciatura righe su `partial` (no stringhe enormi).
# Nota parser NEXS: un `if` senza `else` in cima al file non termina lo statement
# come atteso prima del successivo; usiamo `else { }` vuoto dove serve.

out "[INIT] Fase 3b: Caricamento loghi (nodi per riga)..."



fn host_stream_to_vfs(host_path vfs_path) {
  fd = open(host_path 0)
  if fd < 0 { ret 0 }

  full_content = ""
  chunk_sz = 3200

  loop {
    chunk = read(fd chunk_sz)
    if chunk == "" { break }
    full_content = full_content + chunk
  }
  close(fd)

  vfs_write(vfs_path full_content)
  ret len(full_content)
}

fn try_seed_logo(host_a host_b vfs_path) {
  n = host_stream_to_vfs(host_a vfs_path)
  if n > 0 { ret n }
  ret host_stream_to_vfs(host_b vfs_path)
}

# sd02/logos/ creato da p9_mnt_init (sempre visibile in ls); qui si aggiungono i .nxtimg

loaded = 0

n0 = try_seed_logo("example/minios/logos/logo.nxtimg" "base-nexs/example/minios/logos/logo.nxtimg" "sd02/logos/logo.nxtimg")
if n0 > 0 {
  out "  [OK] logo.nxtimg -> " + str(n0) + " bytes"
  loaded = loaded + 1
} else {
  out "  [WARN] logo.nxtimg non trovato su host (esempio/ o base-nexs/)"
}

n1 = try_seed_logo("example/minios/logos/logo1.nxtimg" "base-nexs/example/minios/logos/logo1.nxtimg" "sd02/logos/logo1.nxtimg")
if n1 > 0 {
  out "  [OK] logo1.nxtimg -> " + str(n1) + " bytes"
  loaded = loaded + 1
} else {
}

n2 = try_seed_logo("example/minios/logos/logo2.nxtimg" "base-nexs/example/minios/logos/logo2.nxtimg" "sd02/logos/logo2.nxtimg")
if n2 > 0 {
  out "  [OK] logo2.nxtimg -> " + str(n2) + " bytes"
  loaded = loaded + 1
} else {
}

# Boot / splash di sistema: logo1 come logo principale se presente
if n1 > 0 {
  reg_set("/sys/logos/main" "sd02/logos/logo1.nxtimg")
} else {
  if n0 > 0 {
    reg_set("/sys/logos/main" "sd02/logos/logo.nxtimg")
  } else {
    if n2 > 0 {
      reg_set("/sys/logos/main" "sd02/logos/logo2.nxtimg")
    } else {
      reg_set("/sys/logos/main" "")
    }
  }
}

reg_set("/sys/logos/count" loaded)
out "[INIT] Caricamento loghi completato (" + str(loaded) + " asset)."
ret 0
