# example/minios/boot.nx — NEXS Boot Script
# ===================================================================

# Enable kernel trace
sys_debug(false)

out "==================================================="
out " [INIT] Booting NEXS Modular Micro-OS"
out "==================================================="
out "[INIT] Fase 1: Caricamento Driver e Servizi (Librerie di Sistema)..."

# Caricamento dei servizi di sistema
exec("services/stdlib.nx")
exec("services/fs/init.nx")     # VFS & Mounts
exec("services/pm/init.nx")     # PM
exec("services/auth/init.nx")   # Auth & capabilities
exec("services/tty/init.nx")    # TTY
exec("services/ui/init.nx")     # UI framebuffer
exec("services/fs/p9_mnt.nx")   # 9P
exec("services/hw_dt.nx")       # HW Device Tree
exec("services/textbuf.nx")     # Text Buffer Library
exec("services/logos/init.nx")  # Logo Registry Service

out "[INIT] Fase 2: Inizializzazione Sottosistemi..."
hw_dt_init()
p9_mnt_init()

out "[INIT] Fase 3: Popolamento Root FS e Caricamento Loghi..."
# I mount standard sono già fatti da services/fs/init.nx
exec("example/minios/logo.nx")  # Carica loghi nel VFS (sd02/logos) - wrapper riutilizzabile
exec("example/minios/logos_config.nx")  # Configurazione loghi e shortcut

# Avvio dei demoni di sistema
exec("example/minios/nxed_editor.nx")
exec("example/minios/termimg.nx")        # TermImg — Image Viewer
exec("example/minios/shell.nx")

out "==================================================="
out " [INIT] Boot completato. Cessione controllo alla UI."
out "==================================================="

shell_loop()