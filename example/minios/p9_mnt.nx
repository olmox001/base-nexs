fn p9_mnt_init() {
  out "[P9] Mounting Plan 9 namespace hierarchy..."

  # Kernel registry root
  reg /sys/ns/reg/type   = "Plan 9 Virtual Kernel Registry"
  reg /sys/ns/reg/status = "active"

  # System services
  reg /sys/ns/services = "VFS_Daemon, Shell_TTY"
  reg /sys/ns/config   = "INIT_MODE=STANDALONE"

  # SD storage namespaces — drivers and system
  reg /sys/ns/sd00/type = "drivers"
  reg /sys/ns/sd01/type = "system"

  # User namespaces sd02-sd98 are allocated on demand
  # sd99 = guest
  reg /sys/ns/sd99/type = "guest"

  out "[P9] Namespace hierarchy mounted."
}

fn p9_mnt_ls(ns_path) {
  out "=== P9 NAMESPACE [" + ns_path + "] ==="
  ls ns_path
}
